\begin{tikzpicture}[
  font=\sffamily\small,
  >=Latex,
  stage/.style={draw=black!55, rounded corners=2pt, very thick, fill=blue!4,
                align=center, text width=3.35cm, minimum height=1.45cm, inner sep=5pt},
  reserve/.style={draw=black!60, rounded corners=2pt, very thick, fill=orange!9,
                  align=center, text width=3.55cm, minimum height=1.45cm, inner sep=5pt},
  score/.style={draw=black!60, rounded corners=2pt, very thick, fill=purple!7,
                align=center, text width=3.45cm, minimum height=1.45cm, inner sep=5pt},
  decision/.style={draw=black!55, rounded corners=2pt, thick, align=center,
                   text width=3.1cm, minimum height=1.18cm, inner sep=4pt},
  flow/.style={->, very thick, draw=black!65},
  note/.style={font=\sffamily\scriptsize, align=center, text width=3.4cm}
]
\node[stage] (world) at (0,0) {\textbf{Current captured world}\\persistent physical state $M_0$\\geometry / appearance / dynamics};
\node[stage] (proposal) at (4.4,0) {\textbf{Propose a physical edit}\\optimizer, calibration, authoring, or learned estimator\\candidate $M_1$};
\node[stage] (freeze) at (8.8,0) {\textbf{Freeze the proposal}\\record $M_0$, $M_1$, protocol, and provenance\\reserved test still unopened};
\node[reserve] (test) at (13.4,0) {\textbf{Open reserved physical evidence}\\new load, held-out motion, or dynamics-matched measurement $Y$\\evaluate both states};
\node[score] (compare) at (18.0,0) {\textbf{Compare under uncertainty}\$z=[e(M_0,Y)-e(M_1,Y)]/\sigma$\\measurement + repeat + numerical error};

\draw[flow] (world) -- node[above,font=\scriptsize]{fitting / ordinary held-out evidence} (proposal);
\draw[flow] (proposal) -- (freeze);
\draw[flow] (freeze) -- node[above,font=\scriptsize]{proposal boundary} (test);
\draw[flow] (test) -- (compare);

\node[decision, fill=green!10] (support) at (13.3,-2.65) {\textbf{SUPPORT}\\reserved evidence favors $M_1$\\\emph{commit candidate}};
\node[decision, fill=red!8] (veto) at (17.0,-2.65) {\textbf{VETO}\\reserved evidence favors $M_0$\\\emph{keep current state}};
\node[decision, fill=yellow!12] (unres) at (20.7,-2.65) {\textbf{UNRESOLVED}\\test cannot separate the states\\\emph{keep $M_0$; redesign test}};

\draw[flow] (compare.south) |- (support.north);
\draw[flow] (compare.south) -- (veto.north);
\draw[flow] (compare.south) |- (unres.north);

\draw[dashed, very thick, black!35] (10.95,1.45) -- (10.95,-3.45);
\node[note, text=black!70] at (10.95,1.9) {reserved evidence is unavailable while the edit is being chosen};
\node[note, text=black!70] at (5.0,-1.85) {\textbf{Proposal side:} improve or author the candidate.\\No physical-certification claim is made here.};
\node[note, text=black!70] at (16.8,-4.05) {\textbf{Acceptance side:} the physical question and uncertainty determine whether the state transition is justified.};
\end{tikzpicture}
