#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(std430, binding = 0) buffer Density { float values[]; } density;
layout(std430, binding = 1) buffer Temperature { float values[]; } temperature;
layout(std430, binding = 2) buffer FaceU0 { float values[]; } faceU0;
layout(std430, binding = 3) buffer FaceV0 { float values[]; } faceV0;
layout(std430, binding = 4) buffer FaceW0 { float values[]; } faceW0;
layout(std430, binding = 5) buffer FaceU1 { float values[]; } faceU1;
layout(std430, binding = 6) buffer FaceV1 { float values[]; } faceV1;
layout(std430, binding = 7) buffer FaceW1 { float values[]; } faceW1;
layout(std430, binding = 8) buffer Divergence { float values[]; } divergence;
layout(std430, binding = 9) buffer Pressure0 { float values[]; } pressure0;
layout(std430, binding = 10) buffer Pressure1 { float values[]; } pressure1;
layout(std430, binding = 11) buffer DivergenceBefore { float values[]; } divergenceBefore;
layout(std430, binding = 12) buffer DensityForward { float values[]; } densityForward;
layout(std430, binding = 13) buffer TemperatureForward { float values[]; } temperatureForward;
layout(std430, binding = 14) buffer DensityBackward { float values[]; } densityBackward;
layout(std430, binding = 15) buffer TemperatureBackward { float values[]; } temperatureBackward;
layout(std430, binding = 16) buffer DensityOutput { float values[]; } densityOutput;
layout(std430, binding = 17) buffer TemperatureOutput { float values[]; } temperatureOutput;
layout(std430, binding = 18) buffer RadianceOutput { float values[]; } radianceOutput;
layout(std430, binding = 19) buffer Obstacles { float values[]; } obstacles;
layout(std430, binding = 20) buffer CurlField { float values[]; } curlField;
layout(std430, binding = 21) buffer DensityHierarchy { float values[]; } densityHierarchy;
layout(std430, binding = 22) buffer CflControl { uint values[]; } cflControl;
layout(std430, binding = 23) buffer CoarseRhs { float values[]; } coarseRhs;
layout(std430, binding = 24) buffer CoarsePressure0 { float values[]; } coarsePressure0;
layout(std430, binding = 25) buffer CoarsePressure1 { float values[]; } coarsePressure1;
layout(std430, binding = 26) buffer ActiveBricks { uint values[]; } activeBricks;
layout(std430, binding = 27) buffer ActiveBricksNext { uint values[]; } activeBricksNext;
layout(std430, binding = 28) readonly buffer MeshVertices { vec4 values[]; } meshVertices;
layout(std430, binding = 29) readonly buffer MeshIndices { uint values[]; } meshIndices;
layout(std430, binding = 30) buffer TriangleForces { vec4 values[]; } triangleForces;
struct RigidBodyState {
  vec4 positionMass;
  vec4 orientation;
  vec4 linearVelocity;
  vec4 angularVelocity;
  vec4 diagonalInertia;
  vec4 scale;
};
layout(std430, binding = 31) buffer RigidBodies { RigidBodyState values[]; } rigidBodies;

layout(push_constant) uniform MacPass {
  uint nx;
  uint ny;
  uint nz;
  uint pass;
  float dt;
  float buoyancy;
  float smokeWeight;
  float parity;
  uint outputWidth;
  uint outputHeight;
  float extinction;
  float emission;
  uint triangleCount;
  float bodyMass;
  uint padding0;
  uint padding1;
} pushData;

float effectiveDt();

uint cellIndex(uvec3 cell) {
  return (cell.z * pushData.ny + cell.y) * pushData.nx + cell.x;
}

uint uIndex(uvec3 face) {
  return (face.z * pushData.ny + face.y) * (pushData.nx + 1u) + face.x;
}

uint vIndex(uvec3 face) {
  return (face.z * (pushData.ny + 1u) + face.y) * pushData.nx + face.x;
}

uint wIndex(uvec3 face) {
  return (face.z * pushData.ny + face.y) * pushData.nx + face.x;
}

uint coarseIndex(uvec3 cell) {
  const uvec3 extent = (uvec3(pushData.nx, pushData.ny, pushData.nz) + 1u) / 2u;
  return (cell.z * extent.y + cell.y) * extent.x + cell.x;
}

uvec3 brickExtent() {
  return (uvec3(pushData.nx, pushData.ny, pushData.nz) + 3u) / 4u;
}

uint brickIndex(uvec3 brick) {
  const uvec3 extent = brickExtent();
  return (brick.z * extent.y + brick.y) * extent.x + brick.x;
}

bool activeCell(uvec3 cell) {
  const uvec3 brick = min(cell / 4u, brickExtent() - 1u);
  return activeBricksNext.values[brickIndex(brick)] != 0u;
}

void classifyActiveBrick(uvec3 id) {
  if (any(greaterThanEqual(id, uvec3(pushData.nx, pushData.ny, pushData.nz)))) return;
  const uint cell = cellIndex(id);
  if (density.values[cell] > 0.002 || temperature.values[cell] > 0.002 ||
      obstacles.values[cell] > 0.5)
    atomicOr(activeBricks.values[brickIndex(id / 4u)], 1u);
}

void dilateActiveBricks(uvec3 brick) {
  const uvec3 extent = brickExtent();
  if (any(greaterThanEqual(brick, extent)) || activeBricks.values[brickIndex(brick)] == 0u) return;
  for (int z = -1; z <= 1; ++z)
    for (int y = -1; y <= 1; ++y)
      for (int x = -1; x <= 1; ++x) {
        const ivec3 neighbour = ivec3(brick) + ivec3(x, y, z);
        if (all(greaterThanEqual(neighbour, ivec3(0))) &&
            all(lessThan(neighbour, ivec3(extent))))
          atomicOr(activeBricksNext.values[brickIndex(uvec3(neighbour))], 1u);
      }
}

vec4 quaternionMultiply(vec4 a, vec4 b) {
  return vec4(a.w * b.xyz + b.w * a.xyz + cross(a.xyz, b.xyz),
              a.w * b.w - dot(a.xyz, b.xyz));
}

vec3 quaternionRotate(vec4 orientation, vec3 value) {
  const vec4 q = normalize(orientation);
  return value + 2.0 * cross(q.xyz, cross(q.xyz, value) + q.w * value);
}

uint meshBodyIndex(uint vertexIndex) {
  return uint(round(meshVertices.values[vertexIndex].w));
}

vec3 worldMeshVertex(uint index) {
  const RigidBodyState body = rigidBodies.values[meshBodyIndex(index)];
  return body.positionMass.xyz + quaternionRotate(
      body.orientation, meshVertices.values[index].xyz * body.scale.xyz);
}

vec3 rigidSurfaceVelocity(uint bodyIndex, vec3 point) {
  const RigidBodyState body = rigidBodies.values[bodyIndex];
  return body.linearVelocity.xyz +
      cross(body.angularVelocity.xyz, point - body.positionMass.xyz);
}

bool rayHitsPositiveX(vec3 origin, vec3 a, vec3 b, vec3 c) {
  const vec3 direction = vec3(1.0, 0.0, 0.0);
  const vec3 edge1 = b - a;
  const vec3 edge2 = c - a;
  const vec3 p = cross(direction, edge2);
  const float determinant = dot(edge1, p);
  if (abs(determinant) < 1e-7) return false;
  const float inverse = 1.0 / determinant;
  const vec3 t = origin - a;
  const float u = dot(t, p) * inverse;
  if (u < 0.0 || u > 1.0) return false;
  const vec3 q = cross(t, edge1);
  const float v = dot(direction, q) * inverse;
  return v >= 0.0 && u + v <= 1.0 && dot(edge2, q) * inverse > 1e-6;
}

void voxelizeTriangleMesh(uvec3 id) {
  if (any(greaterThanEqual(id, uvec3(pushData.nx, pushData.ny, pushData.nz)))) return;
  vec3 point = (vec3(id) + 0.5) / vec3(pushData.nx, pushData.ny, pushData.nz);
  point.y += 1e-6;
  point.z += 1.7e-6;
  const bool floorCell = id.y == 0u;
  float obstacleValue = floorCell ? 1.0 : 0.0;
  for (uint bodyIndex = 0u; !floorCell && bodyIndex < max(pushData.padding0, 1u); ++bodyIndex) {
    uint intersections = 0u;
    for (uint triangle = 0u; triangle < pushData.triangleCount; ++triangle) {
      const uint base = triangle * 3u;
      if (meshBodyIndex(meshIndices.values[base]) != bodyIndex) continue;
      if (rayHitsPositiveX(
          point,
          worldMeshVertex(meshIndices.values[base]),
          worldMeshVertex(meshIndices.values[base + 1u]),
          worldMeshVertex(meshIndices.values[base + 2u])))
        ++intersections;
    }
    if ((intersections & 1u) != 0u) {
      obstacleValue = 2.0 + float(bodyIndex);
      break;
    }
  }
  obstacles.values[cellIndex(id)] = obstacleValue;
}

void integrateTriangleForce(uvec3 id) {
  if (id.y != 0u || id.z != 0u || id.x >= pushData.triangleCount) return;
  const uint base = id.x * 3u;
  const uint bodyIndex = meshBodyIndex(meshIndices.values[base]);
  const vec3 a = worldMeshVertex(meshIndices.values[base]);
  const vec3 b = worldMeshVertex(meshIndices.values[base + 1u]);
  const vec3 c = worldMeshVertex(meshIndices.values[base + 2u]);
  const vec3 areaNormal = 0.5 * cross(b - a, c - a);
  const float area = length(areaNormal);
  const vec3 normal = area > 1e-8 ? areaNormal / area : vec3(0.0);
  const vec3 triangleCenter = (a + b + c) / 3.0;
  const ivec3 cell = clamp(
      ivec3(triangleCenter * vec3(pushData.nx, pushData.ny, pushData.nz)),
      ivec3(0),
      ivec3(pushData.nx, pushData.ny, pushData.nz) - 1);
  const float pressure = pressure0.values[cellIndex(uvec3(cell))];
  const vec3 force = -pressure * area * normal;
  triangleForces.values[id.x * 2u] = vec4(force, uintBitsToFloat(bodyIndex));
  triangleForces.values[id.x * 2u + 1u] =
      vec4(cross(triangleCenter - rigidBodies.values[bodyIndex].positionMass.xyz, force), 0.0);
}

void advanceRigidBody(uvec3 id) {
  if (id.y != 0u || id.z != 0u || id.x >= max(pushData.padding0, 1u)) return;
  const uint bodyIndex = id.x;
  vec3 force = vec3(0.0);
  vec3 torque = vec3(0.0);
  for (uint triangle = 0u; triangle < pushData.triangleCount; ++triangle) {
    if (floatBitsToUint(triangleForces.values[triangle * 2u].w) != bodyIndex) continue;
    force += triangleForces.values[triangle * 2u].xyz;
    torque += triangleForces.values[triangle * 2u + 1u].xyz;
  }
  const float dt = effectiveDt();
  RigidBodyState body = rigidBodies.values[bodyIndex];
  body.linearVelocity.xyz += force * dt / max(body.positionMass.w, 1e-4);
  body.linearVelocity.xyz *= 0.998;
  body.positionMass.xyz = clamp(
      body.positionMass.xyz + body.linearVelocity.xyz * dt,
      vec3(0.12, 0.08, 0.12), vec3(0.88, 0.82, 0.88));
  const vec4 orientation = normalize(body.orientation);
  const vec4 inverseOrientation = vec4(-orientation.xyz, orientation.w);
  const vec3 localTorque = quaternionRotate(inverseOrientation, torque);
  const vec3 localAcceleration = localTorque / max(body.diagonalInertia.xyz, vec3(1e-5));
  body.angularVelocity.xyz += quaternionRotate(orientation, localAcceleration) * dt;
  body.angularVelocity.xyz *= 0.998;
  const vec4 derivative = quaternionMultiply(vec4(body.angularVelocity.xyz, 0.0), orientation);
  body.orientation = normalize(orientation + 0.5 * dt * derivative);
  rigidBodies.values[bodyIndex] = body;
}

bool solid(ivec3 cell) {
  if (any(lessThan(cell, ivec3(0))) ||
      any(greaterThanEqual(cell, ivec3(pushData.nx, pushData.ny, pushData.nz)))) return true;
  return obstacles.values[cellIndex(uvec3(cell))] > 0.5;
}

float obstacleKind(ivec3 cell) {
  if (any(lessThan(cell, ivec3(0))) ||
      any(greaterThanEqual(cell, ivec3(pushData.nx, pushData.ny, pushData.nz)))) return 1.0;
  return obstacles.values[cellIndex(uvec3(cell))];
}

uint movingBodyIndex(ivec3 first, ivec3 second) {
  return uint(max(max(obstacleKind(first), obstacleKind(second)) - 2.0, 0.0) + 0.5);
}

float effectiveDt() {
  const float selected = uintBitsToFloat(cflControl.values[1]);
  return selected > 0.0 && !isnan(selected) && !isinf(selected)
      ? min(pushData.dt, selected) : pushData.dt;
}

float pressureAt(ivec3 cell, bool readSecond) {
  ivec3 maximum = ivec3(pushData.nx, pushData.ny, pushData.nz) - 1;
  cell = clamp(cell, ivec3(0), maximum);
  const uint index = cellIndex(uvec3(cell));
  return readSecond ? pressure1.values[index] : pressure0.values[index];
}

void applyForces(uvec3 id) {
  const float dt = effectiveDt();
  if (id.x <= pushData.nx && id.y < pushData.ny && id.z < pushData.nz) {
    const uint index = uIndex(id);
    const ivec3 left = ivec3(id) - ivec3(1, 0, 0);
    const ivec3 right = ivec3(id);
    if (id.x == 0u || id.x == pushData.nx) faceU1.values[index] = 0.0;
    else if (solid(left) || solid(right)) {
      const vec3 point = vec3(float(id.x) / pushData.nx,
          (float(id.y) + 0.5) / pushData.ny, (float(id.z) + 0.5) / pushData.nz);
      faceU1.values[index] = max(obstacleKind(left), obstacleKind(right)) > 1.5
          ? rigidSurfaceVelocity(movingBodyIndex(left, right), point).x : 0.0;
    } else faceU1.values[index] = faceU0.values[index];
  }
  if (id.x < pushData.nx && id.y <= pushData.ny && id.z < pushData.nz) {
    const uint index = vIndex(id);
    if (id.y == 0u || id.y == pushData.ny ||
        solid(ivec3(id) - ivec3(0, 1, 0)) || solid(ivec3(id))) {
      const ivec3 bottom = ivec3(id) - ivec3(0, 1, 0);
      const ivec3 top = ivec3(id);
      const vec3 point = vec3((float(id.x) + 0.5) / pushData.nx,
          float(id.y) / pushData.ny, (float(id.z) + 0.5) / pushData.nz);
      faceV1.values[index] = id.y != 0u && id.y != pushData.ny &&
          max(obstacleKind(bottom), obstacleKind(top)) > 1.5
          ? rigidSurfaceVelocity(movingBodyIndex(bottom, top), point).y : 0.0;
    } else {
      const uint below = cellIndex(uvec3(id.x, id.y - 1u, id.z));
      const uint above = cellIndex(uvec3(id.x, id.y, id.z));
      const float heat = 0.5 * (temperature.values[below] + temperature.values[above]);
      const float smoke = 0.5 * (density.values[below] + density.values[above]);
      faceV1.values[index] = faceV0.values[index] +
          dt * (pushData.buoyancy * heat - pushData.smokeWeight * smoke);
    }
  }
  if (id.x < pushData.nx && id.y < pushData.ny && id.z <= pushData.nz) {
    const uint index = wIndex(id);
    const ivec3 back = ivec3(id) - ivec3(0, 0, 1);
    const ivec3 front = ivec3(id);
    if (id.z == 0u || id.z == pushData.nz) faceW1.values[index] = 0.0;
    else if (solid(back) || solid(front)) {
      const vec3 point = vec3((float(id.x) + 0.5) / pushData.nx,
          (float(id.y) + 0.5) / pushData.ny, float(id.z) / pushData.nz);
      faceW1.values[index] = max(obstacleKind(back), obstacleKind(front)) > 1.5
          ? rigidSurfaceVelocity(movingBodyIndex(back, front), point).z : 0.0;
    } else faceW1.values[index] = faceW0.values[index];
  }
}

float velocityDivergence(uvec3 cell, bool projected) {
  const float hx = 1.0 / float(pushData.nx);
  const float hy = 1.0 / float(pushData.ny);
  const float hz = 1.0 / float(pushData.nz);
  if (projected) {
    return (faceU0.values[uIndex(cell + uvec3(1, 0, 0))] - faceU0.values[uIndex(cell)]) / hx +
        (faceV0.values[vIndex(cell + uvec3(0, 1, 0))] - faceV0.values[vIndex(cell)]) / hy +
        (faceW0.values[wIndex(cell + uvec3(0, 0, 1))] - faceW0.values[wIndex(cell)]) / hz;
  }
  return (faceU1.values[uIndex(cell + uvec3(1, 0, 0))] - faceU1.values[uIndex(cell)]) / hx +
      (faceV1.values[vIndex(cell + uvec3(0, 1, 0))] - faceV1.values[vIndex(cell)]) / hy +
      (faceW1.values[wIndex(cell + uvec3(0, 0, 1))] - faceW1.values[wIndex(cell)]) / hz;
}

void computeDivergence(uvec3 id, bool projected) {
  if (any(greaterThanEqual(id, uvec3(pushData.nx, pushData.ny, pushData.nz)))) return;
  const uint index = cellIndex(id);
  const float value = solid(ivec3(id)) ? 0.0 : velocityDivergence(id, projected);
  divergence.values[index] = value;
  if (!projected) divergenceBefore.values[index] = value;
}

void solvePressure(uvec3 id) {
  if (any(greaterThanEqual(id, uvec3(pushData.nx, pushData.ny, pushData.nz)))) return;
  const bool readSecond = pushData.parity > 0.5;
  if (solid(ivec3(id))) {
    if (readSecond) pressure0.values[cellIndex(id)] = 0.0;
    else pressure1.values[cellIndex(id)] = 0.0;
    return;
  }
  const float inverseHx2 = float(pushData.nx * pushData.nx);
  const float inverseHy2 = float(pushData.ny * pushData.ny);
  const float inverseHz2 = float(pushData.nz * pushData.nz);
  const ivec3 cell = ivec3(id);
  const float neighbours = inverseHx2 *
          (pressureAt(cell + ivec3(-1, 0, 0), readSecond) +
           pressureAt(cell + ivec3(1, 0, 0), readSecond)) +
      inverseHy2 *
          (pressureAt(cell + ivec3(0, -1, 0), readSecond) +
           pressureAt(cell + ivec3(0, 1, 0), readSecond)) +
      inverseHz2 *
          (pressureAt(cell + ivec3(0, 0, -1), readSecond) +
           pressureAt(cell + ivec3(0, 0, 1), readSecond));
  const float diagonal = 2.0 * (inverseHx2 + inverseHy2 + inverseHz2);
  const float result = (neighbours - divergence.values[cellIndex(id)] / effectiveDt()) / diagonal;
  if (readSecond) pressure0.values[cellIndex(id)] = result;
  else pressure1.values[cellIndex(id)] = result;
}

void projectVelocity(uvec3 id) {
  const bool readSecond = pushData.parity > 0.5;
  const float hx = 1.0 / float(pushData.nx);
  const float hy = 1.0 / float(pushData.ny);
  const float hz = 1.0 / float(pushData.nz);
  if (id.x <= pushData.nx && id.y < pushData.ny && id.z < pushData.nz) {
    const uint index = uIndex(id);
    const ivec3 left = ivec3(id) - ivec3(1, 0, 0);
    const ivec3 right = ivec3(id);
    if (id.x == 0u || id.x == pushData.nx) faceU0.values[index] = 0.0;
    else if (solid(left) || solid(right)) {
      const vec3 point = vec3(float(id.x) / pushData.nx,
          (float(id.y) + 0.5) / pushData.ny, (float(id.z) + 0.5) / pushData.nz);
      faceU0.values[index] = max(obstacleKind(left), obstacleKind(right)) > 1.5
          ? rigidSurfaceVelocity(movingBodyIndex(left, right), point).x : 0.0;
    }
    else faceU0.values[index] = faceU1.values[index] - effectiveDt() *
        (pressureAt(right, readSecond) - pressureAt(left, readSecond)) / hx;
  }
  if (id.x < pushData.nx && id.y <= pushData.ny && id.z < pushData.nz) {
    const uint index = vIndex(id);
    const ivec3 bottom = ivec3(id) - ivec3(0, 1, 0);
    const ivec3 top = ivec3(id);
    if (id.y == 0u || id.y == pushData.ny) faceV0.values[index] = 0.0;
    else if (solid(bottom) || solid(top)) {
      const vec3 point = vec3((float(id.x) + 0.5) / pushData.nx,
          float(id.y) / pushData.ny, (float(id.z) + 0.5) / pushData.nz);
      faceV0.values[index] = max(obstacleKind(bottom), obstacleKind(top)) > 1.5
          ? rigidSurfaceVelocity(movingBodyIndex(bottom, top), point).y : 0.0;
    }
    else faceV0.values[index] = faceV1.values[index] - effectiveDt() *
        (pressureAt(top, readSecond) - pressureAt(bottom, readSecond)) / hy;
  }
  if (id.x < pushData.nx && id.y < pushData.ny && id.z <= pushData.nz) {
    const uint index = wIndex(id);
    const ivec3 back = ivec3(id) - ivec3(0, 0, 1);
    const ivec3 front = ivec3(id);
    if (id.z == 0u || id.z == pushData.nz) faceW0.values[index] = 0.0;
    else if (solid(back) || solid(front)) {
      const vec3 point = vec3((float(id.x) + 0.5) / pushData.nx,
          (float(id.y) + 0.5) / pushData.ny, float(id.z) / pushData.nz);
      faceW0.values[index] = max(obstacleKind(back), obstacleKind(front)) > 1.5
          ? rigidSurfaceVelocity(movingBodyIndex(back, front), point).z : 0.0;
    }
    else faceW0.values[index] = faceW1.values[index] - effectiveDt() *
        (pressureAt(front, readSecond) - pressureAt(back, readSecond)) / hz;
  }
}

float scalarValue(uint field, ivec3 cell) {
  const ivec3 maximum = ivec3(pushData.nx, pushData.ny, pushData.nz) - 1;
  const uint index = cellIndex(uvec3(clamp(cell, ivec3(0), maximum)));
  if (field == 0u) return density.values[index];
  if (field == 1u) return temperature.values[index];
  if (field == 2u) return densityForward.values[index];
  if (field == 3u) return temperatureForward.values[index];
  if (field == 4u) return densityBackward.values[index];
  if (field == 5u) return temperatureBackward.values[index];
  if (field == 6u) return densityOutput.values[index];
  return temperatureOutput.values[index];
}

float sampleScalar(uint field, vec3 position) {
  const vec3 extent = vec3(pushData.nx, pushData.ny, pushData.nz);
  const vec3 gridPosition = clamp(position, vec3(0.0), vec3(1.0)) * extent - 0.5;
  const ivec3 base = ivec3(floor(gridPosition));
  const vec3 fraction = fract(gridPosition);
  float result = 0.0;
  for (int dz = 0; dz <= 1; ++dz) {
    for (int dy = 0; dy <= 1; ++dy) {
      for (int dx = 0; dx <= 1; ++dx) {
        const vec3 weight = mix(vec3(1.0) - fraction, fraction, vec3(dx, dy, dz));
        result += weight.x * weight.y * weight.z *
            scalarValue(field, base + ivec3(dx, dy, dz));
      }
    }
  }
  return result;
}

vec3 velocityAtCell(ivec3 cell) {
  const ivec3 maximum = ivec3(pushData.nx, pushData.ny, pushData.nz) - 1;
  cell = clamp(cell, ivec3(0), maximum);
  const uvec3 resolved = uvec3(cell);
  return vec3(
      0.5 * (faceU0.values[uIndex(resolved)] +
             faceU0.values[uIndex(resolved + uvec3(1, 0, 0))]),
      0.5 * (faceV0.values[vIndex(resolved)] +
             faceV0.values[vIndex(resolved + uvec3(0, 1, 0))]),
      0.5 * (faceW0.values[wIndex(resolved)] +
             faceW0.values[wIndex(resolved + uvec3(0, 0, 1))]));
}

vec3 sampleVelocity(vec3 position) {
  const vec3 extent = vec3(pushData.nx, pushData.ny, pushData.nz);
  const vec3 gridPosition = clamp(position, vec3(0.0), vec3(1.0)) * extent - 0.5;
  const ivec3 base = ivec3(floor(gridPosition));
  const vec3 fraction = fract(gridPosition);
  vec3 result = vec3(0.0);
  for (int dz = 0; dz <= 1; ++dz) {
    for (int dy = 0; dy <= 1; ++dy) {
      for (int dx = 0; dx <= 1; ++dx) {
        const vec3 weight = mix(vec3(1.0) - fraction, fraction, vec3(dx, dy, dz));
        result += weight.x * weight.y * weight.z *
            velocityAtCell(base + ivec3(dx, dy, dz));
      }
    }
  }
  return result;
}

void advectScalars(uvec3 id, bool backward) {
  if (any(greaterThanEqual(id, uvec3(pushData.nx, pushData.ny, pushData.nz)))) return;
  const vec3 extent = vec3(pushData.nx, pushData.ny, pushData.nz);
  const vec3 position = (vec3(id) + 0.5) / extent;
  const float signedDt = backward ? -effectiveDt() : effectiveDt();
  const vec3 velocity = sampleVelocity(position);
  const vec3 midpoint = position - 0.5 * signedDt * velocity;
  const vec3 departure = position - signedDt * sampleVelocity(midpoint);
  const uint densityField = backward ? 2u : 0u;
  const uint temperatureField = backward ? 3u : 1u;
  const uint index = cellIndex(id);
  if (backward) {
    densityBackward.values[index] = sampleScalar(densityField, departure);
    temperatureBackward.values[index] = sampleScalar(temperatureField, departure);
  } else {
    densityForward.values[index] = sampleScalar(densityField, departure);
    temperatureForward.values[index] = sampleScalar(temperatureField, departure);
  }
}

void correctScalars(uvec3 id) {
  if (any(greaterThanEqual(id, uvec3(pushData.nx, pushData.ny, pushData.nz)))) return;
  const ivec3 cell = ivec3(id);
  float densityMinimum = 1e30;
  float densityMaximum = -1e30;
  float temperatureMinimum = 1e30;
  float temperatureMaximum = -1e30;
  for (int dz = -1; dz <= 1; ++dz) {
    for (int dy = -1; dy <= 1; ++dy) {
      for (int dx = -1; dx <= 1; ++dx) {
        const float sourceDensity = scalarValue(0u, cell + ivec3(dx, dy, dz));
        const float sourceTemperature = scalarValue(1u, cell + ivec3(dx, dy, dz));
        densityMinimum = min(densityMinimum, sourceDensity);
        densityMaximum = max(densityMaximum, sourceDensity);
        temperatureMinimum = min(temperatureMinimum, sourceTemperature);
        temperatureMaximum = max(temperatureMaximum, sourceTemperature);
      }
    }
  }
  const uint index = cellIndex(id);
  densityOutput.values[index] = 0.998 * clamp(
      densityForward.values[index] + 0.5 *
          (density.values[index] - densityBackward.values[index]),
      densityMinimum, densityMaximum);
  temperatureOutput.values[index] = 0.996 * clamp(
      temperatureForward.values[index] + 0.5 *
          (temperature.values[index] - temperatureBackward.values[index]),
      temperatureMinimum, temperatureMaximum);
}

void commitAndInject(uvec3 id) {
  if (any(greaterThanEqual(id, uvec3(pushData.nx, pushData.ny, pushData.nz)))) return;
  const vec3 position = (vec3(id) + 0.5) /
      vec3(pushData.nx, pushData.ny, pushData.nz);
  const vec3 sourcePosition = vec3(0.5, 0.11, 0.5);
  const vec3 sourceDelta = position - sourcePosition;
  const float source = exp(-dot(sourceDelta * vec3(1.0, 1.8, 1.0),
                                sourceDelta * vec3(1.0, 1.8, 1.0)) / 0.008);
  const uint index = cellIndex(id);
  if (solid(ivec3(id))) {
    density.values[index] = 0.0;
    temperature.values[index] = 0.0;
    return;
  }
  density.values[index] = min(1.0, densityOutput.values[index] + effectiveDt() * 2.2 * source);
  temperature.values[index] = min(
      1.0, temperatureOutput.values[index] + effectiveDt() * 3.5 * source);
}

void reduceMaximumSpeed(uvec3 id) {
  if (any(greaterThanEqual(id, uvec3(pushData.nx, pushData.ny, pushData.nz)))) return;
  const float speed = length(velocityAtCell(ivec3(id)));
  atomicMax(cflControl.values[0], floatBitsToUint(max(speed, 0.0)));
}

void finalizeCfl(uvec3 id) {
  if (any(greaterThan(id, uvec3(0)))) return;
  const float speed = uintBitsToFloat(cflControl.values[0]);
  const float inverseCell = float(max(pushData.nx, max(pushData.ny, pushData.nz)));
  const float selected = speed > 1e-6 ? min(pushData.dt, 0.70 / (speed * inverseCell)) : pushData.dt;
  cflControl.values[1] = floatBitsToUint(selected);
  cflControl.values[2] = floatBitsToUint(speed * selected * inverseCell);
}

void computeCurl(uvec3 id) {
  if (any(greaterThanEqual(id, uvec3(pushData.nx, pushData.ny, pushData.nz)))) return;
  const ivec3 p = ivec3(id);
  const vec3 xp = velocityAtCell(p + ivec3(1, 0, 0));
  const vec3 xm = velocityAtCell(p - ivec3(1, 0, 0));
  const vec3 yp = velocityAtCell(p + ivec3(0, 1, 0));
  const vec3 ym = velocityAtCell(p - ivec3(0, 1, 0));
  const vec3 zp = velocityAtCell(p + ivec3(0, 0, 1));
  const vec3 zm = velocityAtCell(p - ivec3(0, 0, 1));
  const vec3 curl = 0.5 * vec3(
      float(pushData.ny) * (yp.z - ym.z) - float(pushData.nz) * (zp.y - zm.y),
      float(pushData.nz) * (zp.x - zm.x) - float(pushData.nx) * (xp.z - xm.z),
      float(pushData.nx) * (xp.y - xm.y) - float(pushData.ny) * (yp.x - ym.x));
  const uint index = cellIndex(id) * 3u;
  curlField.values[index] = curl.x;
  curlField.values[index + 1u] = curl.y;
  curlField.values[index + 2u] = curl.z;
}

vec3 curlAt(ivec3 cell) {
  const ivec3 p = clamp(cell, ivec3(0), ivec3(pushData.nx, pushData.ny, pushData.nz) - 1);
  const uint index = cellIndex(uvec3(p)) * 3u;
  return vec3(curlField.values[index], curlField.values[index + 1u], curlField.values[index + 2u]);
}

void applyVorticity(uvec3 id) {
  if (any(greaterThanEqual(id, uvec3(pushData.nx, pushData.ny, pushData.nz))) || solid(ivec3(id))) return;
  const ivec3 p = ivec3(id);
  const vec3 gradient = 0.5 * vec3(
      length(curlAt(p + ivec3(1, 0, 0))) - length(curlAt(p - ivec3(1, 0, 0))),
      length(curlAt(p + ivec3(0, 1, 0))) - length(curlAt(p - ivec3(0, 1, 0))),
      length(curlAt(p + ivec3(0, 0, 1))) - length(curlAt(p - ivec3(0, 0, 1))));
  const vec3 confinement = cross(gradient / max(length(gradient), 1e-6), curlAt(p)) *
      (0.08 * effectiveDt());
  faceU1.values[uIndex(id)] += confinement.x;
  faceV1.values[vIndex(id)] += confinement.y;
  faceW1.values[wIndex(id)] += confinement.z;
}

void restrictPressureResidual(uvec3 id) {
  const uvec3 coarseExtent = (uvec3(pushData.nx, pushData.ny, pushData.nz) + 1u) / 2u;
  if (any(greaterThanEqual(id, coarseExtent))) return;
  float sum = 0.0;
  float count = 0.0;
  for (uint z = 0u; z < 2u; ++z) for (uint y = 0u; y < 2u; ++y) for (uint x = 0u; x < 2u; ++x) {
    const uvec3 fine = id * 2u + uvec3(x, y, z);
    if (all(lessThan(fine, uvec3(pushData.nx, pushData.ny, pushData.nz)))) {
      sum += divergence.values[cellIndex(fine)];
      count += 1.0;
    }
  }
  coarseRhs.values[coarseIndex(id)] = sum / max(count, 1.0);
}

float coarsePressureAt(ivec3 cell, bool second) {
  const ivec3 extent = ivec3((uvec3(pushData.nx, pushData.ny, pushData.nz) + 1u) / 2u);
  const uint index = coarseIndex(uvec3(clamp(cell, ivec3(0), extent - 1)));
  return second ? coarsePressure1.values[index] : coarsePressure0.values[index];
}

void solveCoarsePressure(uvec3 id) {
  const uvec3 extent = (uvec3(pushData.nx, pushData.ny, pushData.nz) + 1u) / 2u;
  if (any(greaterThanEqual(id, extent))) return;
  const bool second = pushData.parity > 0.5;
  const ivec3 p = ivec3(id);
  const vec3 inverseH2 = vec3(extent * extent);
  const float neighbours = inverseH2.x *
          (coarsePressureAt(p + ivec3(1, 0, 0), second) +
           coarsePressureAt(p - ivec3(1, 0, 0), second)) +
      inverseH2.y *
          (coarsePressureAt(p + ivec3(0, 1, 0), second) +
           coarsePressureAt(p - ivec3(0, 1, 0), second)) +
      inverseH2.z *
          (coarsePressureAt(p + ivec3(0, 0, 1), second) +
           coarsePressureAt(p - ivec3(0, 0, 1), second));
  const float diagonal = 2.0 * (inverseH2.x + inverseH2.y + inverseH2.z);
  const float value = (neighbours - coarseRhs.values[coarseIndex(id)] / effectiveDt()) / diagonal;
  if (second) coarsePressure0.values[coarseIndex(id)] = value;
  else coarsePressure1.values[coarseIndex(id)] = value;
}

void prolongateCoarsePressure(uvec3 id) {
  if (any(greaterThanEqual(id, uvec3(pushData.nx, pushData.ny, pushData.nz)))) return;
  const bool second = pushData.parity > 0.5;
  pressure0.values[cellIndex(id)] += coarsePressureAt(ivec3(id / 2u), second);
  pressure1.values[cellIndex(id)] = pressure0.values[cellIndex(id)];
}

void buildDensityHierarchy(uvec3 id) {
  const uvec3 extent = (uvec3(pushData.nx, pushData.ny, pushData.nz) + 1u) / 2u;
  if (any(greaterThanEqual(id, extent))) return;
  float maximumDensity = 0.0;
  for (uint z = 0u; z < 2u; ++z) for (uint y = 0u; y < 2u; ++y) for (uint x = 0u; x < 2u; ++x) {
    const uvec3 fine = id * 2u + uvec3(x, y, z);
    if (all(lessThan(fine, uvec3(pushData.nx, pushData.ny, pushData.nz))))
      maximumDensity = max(maximumDensity, density.values[cellIndex(fine)]);
  }
  densityHierarchy.values[coarseIndex(id)] = maximumDensity;
}

vec2 intersectUnitBox(vec3 origin, vec3 direction) {
  const vec3 inverseDirection = 1.0 / direction;
  const vec3 nearPlane = (vec3(0.0) - origin) * inverseDirection;
  const vec3 farPlane = (vec3(1.0) - origin) * inverseDirection;
  const vec3 minimumDistance = min(nearPlane, farPlane);
  const vec3 maximumDistance = max(nearPlane, farPlane);
  return vec2(
      max(max(minimumDistance.x, minimumDistance.y), minimumDistance.z),
      min(min(maximumDistance.x, maximumDistance.y), maximumDistance.z));
}

float hierarchyDensity(vec3 position) {
  const uvec3 extent = (uvec3(pushData.nx, pushData.ny, pushData.nz) + 1u) / 2u;
  const uvec3 cell = min(uvec3(clamp(position, vec3(0.0), vec3(0.999999)) * vec3(extent)), extent - 1u);
  return densityHierarchy.values[coarseIndex(cell)];
}

float lightTransmittance(vec3 position) {
  const vec3 lightDirection = normalize(vec3(-0.45, 0.72, -0.52));
  float opticalDepth = 0.0;
  for (uint step = 0u; step < 12u; ++step) {
    const vec3 samplePosition = position + lightDirection * (float(step) + 0.5) * 0.035;
    if (any(lessThan(samplePosition, vec3(0.0))) || any(greaterThan(samplePosition, vec3(1.0)))) break;
    opticalDepth += max(sampleScalar(0u, samplePosition), 0.0) * 0.035 * pushData.extinction;
  }
  return exp(-opticalDepth);
}

void rayMarchVolume(uvec3 id) {
  if (id.z != 0u || id.x >= pushData.outputWidth || id.y >= pushData.outputHeight) return;
  const vec2 uv = (vec2(id.xy) + 0.5) / vec2(pushData.outputWidth, pushData.outputHeight);
  const float aspect = float(pushData.outputWidth) / float(pushData.outputHeight);
  const vec3 origin = vec3(0.5, 0.48, -0.92);
  const vec3 direction = normalize(vec3((uv.x - 0.5) * 0.62 * aspect, (uv.y - 0.5) * 0.62, 1.0));
  const vec2 intersection = intersectUnitBox(origin, direction);
  vec3 radiance = vec3(0.003, 0.005, 0.011);
  float transmittance = 1.0;
  if (intersection.y > max(intersection.x, 0.0)) {
    const float begin = max(intersection.x, 0.0);
    const float stepLength = (intersection.y - begin) / 96.0;
    for (uint step = 0u; step < 96u; ++step) {
      const float distance = begin + (float(step) + 0.5) * stepLength;
      const vec3 position = origin + distance * direction;
      if (hierarchyDensity(position) < 0.002) {
        step = min(step + 3u, 95u);
        continue;
      }
      const float smoke = max(sampleScalar(0u, position), 0.0);
      const float heat = max(sampleScalar(1u, position), 0.0);
      const float opticalDepth = pushData.extinction * smoke * stepLength;
      const float absorption = 1.0 - exp(-opticalDepth);
      const float shadow = lightTransmittance(position);
      const vec3 singleScatter = mix(vec3(0.10, 0.12, 0.16), vec3(0.72, 0.75, 0.82), heat) * shadow;
      const vec3 multipleScatter = vec3(0.18, 0.20, 0.24) * (1.0 - shadow) *
          (1.0 - exp(-2.0 * opticalDepth));
      const vec3 fire = pushData.emission * heat * heat *
          mix(vec3(1.9, 0.18, 0.015), vec3(1.4, 0.72, 0.16), heat);
      radiance += transmittance * absorption * (singleScatter + multipleScatter + fire);
      transmittance *= exp(-opticalDepth);
      if (transmittance < 0.005) break;
    }
  }
  const uint pixel = id.y * pushData.outputWidth + id.x;
  radianceOutput.values[pixel * 4u + 0u] = radiance.r;
  radianceOutput.values[pixel * 4u + 1u] = radiance.g;
  radianceOutput.values[pixel * 4u + 2u] = radiance.b;
  radianceOutput.values[pixel * 4u + 3u] = 1.0;
}

void main() {
  const uvec3 id = gl_GlobalInvocationID.xyz;
  if (pushData.pass == 18u) {
    classifyActiveBrick(id);
    return;
  }
  if (pushData.pass == 19u) {
    dilateActiveBricks(id);
    return;
  }
  if (pushData.pass == 20u) {
    voxelizeTriangleMesh(id);
    return;
  }
  if (pushData.pass == 21u) {
    integrateTriangleForce(id);
    return;
  }
  if (pushData.pass == 22u) {
    advanceRigidBody(id);
    return;
  }
  const bool sparseSimulationPass =
      pushData.pass <= 7u || pushData.pass == 9u || pushData.pass == 12u || pushData.pass == 13u;
  if (sparseSimulationPass && !activeCell(id)) return;
  if (pushData.pass == 0u) applyForces(id);
  else if (pushData.pass == 1u) computeDivergence(id, false);
  else if (pushData.pass == 2u) solvePressure(id);
  else if (pushData.pass == 3u) projectVelocity(id);
  else if (pushData.pass == 4u) computeDivergence(id, true);
  else if (pushData.pass == 5u) advectScalars(id, false);
  else if (pushData.pass == 6u) advectScalars(id, true);
  else if (pushData.pass == 7u) correctScalars(id);
  else if (pushData.pass == 8u) rayMarchVolume(id);
  else if (pushData.pass == 9u) commitAndInject(id);
  else if (pushData.pass == 10u) reduceMaximumSpeed(id);
  else if (pushData.pass == 11u) finalizeCfl(id);
  else if (pushData.pass == 12u) computeCurl(id);
  else if (pushData.pass == 13u) applyVorticity(id);
  else if (pushData.pass == 14u) restrictPressureResidual(id);
  else if (pushData.pass == 15u) solveCoarsePressure(id);
  else if (pushData.pass == 16u) prolongateCoarsePressure(id);
  else if (pushData.pass == 17u) buildDensityHierarchy(id);
}
