#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 28) readonly buffer MeshVertices { vec4 values[]; } meshVertices;

struct RigidBodyState {
  vec4 positionMass;
  vec4 orientation;
  vec4 linearVelocity;
  vec4 angularVelocity;
  vec4 diagonalInertia;
  vec4 scale;
};
layout(std430, binding = 31) buffer RigidBodies { RigidBodyState values[]; } rigidBodies;

layout(push_constant) uniform MacPass {
  uint nx;
  uint ny;
  uint nz;
  uint pass;
  float dt;
  float buoyancy;
  float smokeWeight;
  float parity;
  uint outputWidth;
  uint outputHeight;
  float extinction;
  float emission;
  uint triangleCount;
  float bodyMass;
  uint bodyCount;
  uint padding1;
} pushData;

vec3 quaternionRotate(vec4 orientation, vec3 value) {
  const vec4 q = normalize(orientation);
  return value + 2.0 * cross(q.xyz, cross(q.xyz, value) + q.w * value);
}

uint meshBodyIndex(uint vertexIndex) {
  return uint(round(meshVertices.values[vertexIndex].w));
}

vec3 worldMeshVertex(uint index) {
  const RigidBodyState body = rigidBodies.values[meshBodyIndex(index)];
  return body.positionMass.xyz + quaternionRotate(
      body.orientation, meshVertices.values[index].xyz * body.scale.xyz);
}

void bodyBounds(uint bodyIndex, out vec3 minimum, out vec3 maximum) {
  minimum = vec3(1e20);
  maximum = vec3(-1e20);
  for (uint vertex = 0u; vertex < meshVertices.values.length(); ++vertex) {
    if (meshBodyIndex(vertex) != bodyIndex) continue;
    const vec3 point = worldMeshVertex(vertex);
    minimum = min(minimum, point);
    maximum = max(maximum, point);
  }
}

vec3 applyWorldInverseInertia(RigidBodyState body, vec3 worldValue) {
  const vec4 orientation = normalize(body.orientation);
  const vec3 local = quaternionRotate(vec4(-orientation.xyz, orientation.w), worldValue);
  return quaternionRotate(
      orientation, local / max(body.diagonalInertia.xyz, vec3(1e-5)));
}

void applyContactImpulse(
    inout RigidBodyState a,
    inout RigidBodyState b,
    vec3 contact,
    vec3 direction,
    float magnitude) {
  const vec3 impulse = direction * magnitude;
  const vec3 radiusA = contact - a.positionMass.xyz;
  const vec3 radiusB = contact - b.positionMass.xyz;
  a.linearVelocity.xyz -= impulse / max(a.positionMass.w, 1e-4);
  b.linearVelocity.xyz += impulse / max(b.positionMass.w, 1e-4);
  a.angularVelocity.xyz -= applyWorldInverseInertia(a, cross(radiusA, impulse));
  b.angularVelocity.xyz += applyWorldInverseInertia(b, cross(radiusB, impulse));
}

void main() {
  for (uint first = 0u; first < pushData.bodyCount; ++first) {
    for (uint second = first + 1u; second < pushData.bodyCount; ++second) {
      RigidBodyState a = rigidBodies.values[first];
      RigidBodyState b = rigidBodies.values[second];
      vec3 minimumA, maximumA, minimumB, maximumB;
      bodyBounds(first, minimumA, maximumA);
      bodyBounds(second, minimumB, maximumB);
      const vec3 overlap = min(maximumA, maximumB) - max(minimumA, minimumB);
      if (any(lessThanEqual(overlap, vec3(0.0)))) continue;
      uint axis = overlap.y < overlap.x ? 1u : 0u;
      if (overlap.z < overlap[axis]) axis = 2u;
      vec3 normal = vec3(0.0);
      normal[axis] = b.positionMass[axis] >= a.positionMass[axis] ? 1.0 : -1.0;
      const float inverseMassA = 1.0 / max(a.positionMass.w, 1e-4);
      const float inverseMassB = 1.0 / max(b.positionMass.w, 1e-4);
      const float inverseMass = inverseMassA + inverseMassB;
      const vec3 correction = normal * overlap[axis] / inverseMass;
      a.positionMass.xyz -= correction * inverseMassA;
      b.positionMass.xyz += correction * inverseMassB;
      const vec3 contact = 0.5 * (max(minimumA, minimumB) + min(maximumA, maximumB));
      const vec3 radiusA = contact - a.positionMass.xyz;
      const vec3 radiusB = contact - b.positionMass.xyz;
      vec3 relativeVelocity =
          b.linearVelocity.xyz + cross(b.angularVelocity.xyz, radiusB) -
          a.linearVelocity.xyz - cross(a.angularVelocity.xyz, radiusA);
      const float closingSpeed = dot(relativeVelocity, normal);
      if (closingSpeed < 0.0) {
        const vec3 angularA = cross(applyWorldInverseInertia(a, cross(radiusA, normal)), radiusA);
        const vec3 angularB = cross(applyWorldInverseInertia(b, cross(radiusB, normal)), radiusB);
        const float denominator = inverseMass + dot(normal, angularA + angularB);
        const float normalMagnitude = -1.1 * closingSpeed / max(denominator, 1e-5);
        applyContactImpulse(a, b, contact, normal, normalMagnitude);
        relativeVelocity =
            b.linearVelocity.xyz + cross(b.angularVelocity.xyz, radiusB) -
            a.linearVelocity.xyz - cross(a.angularVelocity.xyz, radiusA);
        const vec3 tangentVelocity = relativeVelocity - normal * dot(relativeVelocity, normal);
        const float tangentSpeed = length(tangentVelocity);
        if (tangentSpeed > 1e-5) {
          const vec3 tangent = tangentVelocity / tangentSpeed;
          const vec3 tangentA = cross(applyWorldInverseInertia(a, cross(radiusA, tangent)), radiusA);
          const vec3 tangentB = cross(applyWorldInverseInertia(b, cross(radiusB, tangent)), radiusB);
          const float tangentDenominator = inverseMass + dot(tangent, tangentA + tangentB);
          const float tangentMagnitude = clamp(
              -dot(relativeVelocity, tangent) / max(tangentDenominator, 1e-5),
              -0.4 * normalMagnitude, 0.4 * normalMagnitude);
          applyContactImpulse(a, b, contact, tangent, tangentMagnitude);
        }
      }
      rigidBodies.values[first] = a;
      rigidBodies.values[second] = b;
    }
  }
}
