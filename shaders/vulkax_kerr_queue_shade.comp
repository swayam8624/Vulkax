#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

struct RayState {
    vec4 position;
    vec4 conservedSigns;
    vec4 integration;
    vec4 jacobiPosition;
    vec4 jacobiWave;
    vec4 horizontal;
    vec4 horizontalDerivative;
    vec4 vertical;
    vec4 verticalDerivative;
    vec4 jacobiDiagnostics;
    vec4 transfer;
    uvec4 counters;
};

layout(set = 0, binding = 0, rgba16f) uniform image2D outputRadiance;
layout(set = 0, binding = 1, std430) readonly buffer RayStates {
    RayState values[];
} rays;

layout(push_constant) uniform ShadePush {
    uint outputWidth;
    uint outputHeight;
    uint queueWidth;
    uint queueHeight;
    float mass;
    float spin;
    float diskGain;
    float exposure;
    float alphaPerRay;
    float betaPerRay;
    float observerInclination;
    float frameIndex;
} pushData;

float hash21(vec2 value) {
    value = fract(value * vec2(123.34, 345.45));
    value += dot(value, value + 34.345);
    return fract(value.x * value.y);
}

vec3 filteredCelestial(vec2 source, vec2 sourceDx, vec2 sourceDy) {
    const vec2 grid = vec2(71.0, 37.0);
    const vec2 point = source * grid;
    const ivec2 base = ivec2(floor(point));
    const vec2 bundleX = sourceDx * grid;
    const vec2 bundleY = sourceDy * grid;
    const float baseVariance = 0.000784;
    const float covarianceXX = baseVariance +
        (bundleX.x * bundleX.x + bundleY.x * bundleY.x) / 12.0;
    const float covarianceXY =
        (bundleX.x * bundleX.y + bundleY.x * bundleY.y) / 12.0;
    const float covarianceYY = baseVariance +
        (bundleX.y * bundleX.y + bundleY.y * bundleY.y) / 12.0;
    const float determinant = max(
        covarianceXX * covarianceYY - covarianceXY * covarianceXY,
        baseVariance * baseVariance);
    const mat2 inverseCovariance = mat2(
        covarianceYY, -covarianceXY,
        -covarianceXY, covarianceXX) / determinant;
    const float conservedPeak = baseVariance / sqrt(determinant);
    vec3 stars = vec3(0.0);
    for (int offsetY = -1; offsetY <= 1; ++offsetY) {
        const int cellY = base.y + offsetY;
        if (cellY < 0 || cellY >= int(grid.y)) continue;
        for (int offsetX = -1; offsetX <= 1; ++offsetX) {
            const int cellX = base.x + offsetX;
            const vec2 canonical = vec2(mod(float(cellX), grid.x), float(cellY));
            const vec2 starPosition = vec2(float(cellX), float(cellY)) +
                vec2(hash21(canonical), hash21(canonical + 19.17));
            const vec2 delta = point - starPosition;
            const float exponent = -0.5 * dot(delta, inverseCovariance * delta);
            const float presence = smoothstep(0.86, 0.92, hash21(canonical + 31.73));
            const float temperature = 0.45 + 0.55 * hash21(canonical + 7.2);
            stars += presence * conservedPeak * exp(max(exponent, -32.0)) * mix(
                vec3(0.48, 0.74, 2.0), vec3(2.2, 0.88, 0.34), temperature);
        }
    }
    return vec3(0.006, 0.010, 0.030) + stars;
}

vec3 diskEmission(RayState ray) {
    if (ray.transfer.y < 0.5 || ray.transfer.x <= 0.0) return vec3(0.0);
    const float radius = ray.transfer.x / max(pushData.mass, 0.2);
    const float innerWindow = smoothstep(2.7, 4.0, radius);
    const float outerWindow = 1.0 - smoothstep(9.0, 13.5, radius);
    const float thermal = pow(4.0 / max(radius, 4.0), 0.75);
    const float doppler = clamp(1.0 + 0.55 * sin(ray.position.z), 0.18, 1.82);
    const float multipleImageGain = 1.0 + 0.12 * min(ray.transfer.y - 1.0, 4.0);
    return vec3(2.4, 0.62, 0.10) * innerWindow * outerWindow * thermal *
        pow(doppler, 3.0) * multipleImageGain * max(pushData.diskGain, 0.0);
}

vec3 shadeRay(RayState ray, vec2 uv) {
    vec3 radiance = diskEmission(ray);
    if (ray.counters.x == 0u) {
        radiance += vec3(0.0015, 0.0020, 0.0040) * (0.7 + 0.3 * uv.y);
    } else if (ray.counters.x == 2u && ray.counters.w != 0u) {
        const float sine = max(sin(ray.jacobiPosition.z), 1e-5);
        const vec2 source = vec2(
            fract(ray.jacobiPosition.w / 6.28318530718 + 0.5),
            clamp(ray.jacobiPosition.z / 3.14159265359, 0.0, 1.0));
        const vec2 sourceDx = vec2(
            ray.horizontal.w * sine / 6.28318530718,
            ray.horizontal.z / 3.14159265359) * pushData.alphaPerRay;
        const vec2 sourceDy = vec2(
            ray.vertical.w * sine / 6.28318530718,
            ray.vertical.z / 3.14159265359) * pushData.betaPerRay;
        radiance += filteredCelestial(source, sourceDx, sourceDy);
    }
    return radiance;
}

vec4 bundleFootprint(RayState ray) {
    if (ray.counters.x != 2u || ray.counters.w == 0u) return vec4(0.0);
    const float sine = max(sin(ray.jacobiPosition.z), 1e-5);
    const vec2 sourceDx = vec2(
        ray.horizontal.w * sine / 6.28318530718,
        ray.horizontal.z / 3.14159265359) * pushData.alphaPerRay;
    const vec2 sourceDy = vec2(
        ray.vertical.w * sine / 6.28318530718,
        ray.vertical.z / 3.14159265359) * pushData.betaPerRay;
    return vec4(sourceDx, sourceDy);
}

void main() {
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pushData.outputWidth || pixel.y >= pushData.outputHeight) return;
    const vec2 uv = (vec2(pixel) + 0.5) / vec2(pushData.outputWidth, pushData.outputHeight);
    const vec2 queueCoordinate = uv * vec2(pushData.queueWidth, pushData.queueHeight) - 0.5;
    const ivec2 lower = ivec2(floor(queueCoordinate));
    const vec2 fraction = fract(queueCoordinate);
    const ivec2 maximum = ivec2(pushData.queueWidth - 1u, pushData.queueHeight - 1u);
    const ivec2 q00 = clamp(lower, ivec2(0), maximum);
    const ivec2 q10 = clamp(lower + ivec2(1, 0), ivec2(0), maximum);
    const ivec2 q01 = clamp(lower + ivec2(0, 1), ivec2(0), maximum);
    const ivec2 q11 = clamp(lower + ivec2(1, 1), ivec2(0), maximum);
    const RayState r00 = rays.values[uint(q00.y) * pushData.queueWidth + uint(q00.x)];
    const RayState r10 = rays.values[uint(q10.y) * pushData.queueWidth + uint(q10.x)];
    const RayState r01 = rays.values[uint(q01.y) * pushData.queueWidth + uint(q01.x)];
    const RayState r11 = rays.values[uint(q11.y) * pushData.queueWidth + uint(q11.x)];
    vec4 footprint;
    if (r00.counters.x == r10.counters.x && r00.counters.x == r01.counters.x &&
        r00.counters.x == r11.counters.x) {
        const vec4 lowerFootprint = mix(bundleFootprint(r00), bundleFootprint(r10), fraction.x);
        const vec4 upperFootprint = mix(bundleFootprint(r01), bundleFootprint(r11), fraction.x);
        footprint = mix(lowerFootprint, upperFootprint, fraction.y);
    } else {
        const ivec2 nearest = clamp(ivec2(round(queueCoordinate)), ivec2(0), maximum);
        footprint = bundleFootprint(
            rays.values[uint(nearest.y) * pushData.queueWidth + uint(nearest.x)]);
    }
    if (any(isnan(footprint)) || any(isinf(footprint))) footprint = vec4(0.0);
    imageStore(outputRadiance, ivec2(pixel), footprint);
}
