#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D outputRadiance;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D kerrBundleFootprint;

layout(push_constant) uniform DirectFrameConstants {
  float timeSeconds;
  float width;
  float height;
  float exposure;
  float mode;
  float mass;
  float diskGain;
  float cameraScale;
  float spin;
  float sampleIndex;
  float observerInclination;
  float bundleScale;
} frame;

struct GeodesicState {
  float radius;
  float radialVelocity;
  float azimuth;
};

GeodesicState derivative(GeodesicState state, float mass, float angularMomentum) {
  const float radius2 = state.radius * state.radius;
  const float radius3 = radius2 * state.radius;
  const float radius4 = radius3 * state.radius;
  return GeodesicState(
      state.radialVelocity,
      angularMomentum * angularMomentum / radius3 - 3.0 * mass * angularMomentum * angularMomentum / radius4,
      angularMomentum / radius2);
}

GeodesicState rk4(GeodesicState state, float mass, float angularMomentum, float step) {
  const GeodesicState k1 = derivative(state, mass, angularMomentum);
  const GeodesicState k2 = derivative(GeodesicState(
      state.radius + 0.5 * step * k1.radius,
      state.radialVelocity + 0.5 * step * k1.radialVelocity,
      state.azimuth + 0.5 * step * k1.azimuth), mass, angularMomentum);
  const GeodesicState k3 = derivative(GeodesicState(
      state.radius + 0.5 * step * k2.radius,
      state.radialVelocity + 0.5 * step * k2.radialVelocity,
      state.azimuth + 0.5 * step * k2.azimuth), mass, angularMomentum);
  const GeodesicState k4 = derivative(GeodesicState(
      state.radius + step * k3.radius,
      state.radialVelocity + step * k3.radialVelocity,
      state.azimuth + step * k3.azimuth), mass, angularMomentum);
  return GeodesicState(
      state.radius + step * (k1.radius + 2.0 * k2.radius + 2.0 * k3.radius + k4.radius) / 6.0,
      state.radialVelocity + step * (k1.radialVelocity + 2.0 * k2.radialVelocity + 2.0 * k3.radialVelocity + k4.radialVelocity) / 6.0,
      state.azimuth + step * (k1.azimuth + 2.0 * k2.azimuth + 2.0 * k3.azimuth + k4.azimuth) / 6.0);
}

float hash21(vec2 value) {
  value = fract(value * vec2(123.34, 345.45));
  value += dot(value, value + 34.345);
  return fract(value.x * value.y);
}

vec3 celestialRadiance(vec2 direction) {
  const vec2 cell = floor(direction * vec2(37.0, 19.0));
  const vec2 local = fract(direction * vec2(37.0, 19.0)) - 0.5;
  const float star = smoothstep(0.06, 0.0, length(local - (vec2(hash21(cell), hash21(cell + 19.17)) - 0.5)));
  const float temperature = 0.45 + 0.55 * hash21(cell + 7.2);
  return vec3(0.006, 0.010, 0.026) + star * mix(vec3(0.48, 0.72, 1.8), vec3(2.0, 0.92, 0.42), temperature);
}

vec3 schwarzschildRadiance(vec2 uv) {
  const float aspect = frame.width / max(frame.height, 1.0);
  const vec2 image = (uv - 0.5) * vec2(2.0 * aspect, 2.0) / max(frame.cameraScale, 0.1);
  const float mass = max(frame.mass, 0.2);
  const float observerRadius = 52.0;
  const vec3 radial = vec3(1.0, 0.0, 0.0);
  const vec3 direction = normalize(vec3(-1.0, image.x, image.y));
  const float radialVelocity = dot(direction, radial);
  const vec3 tangentVector = direction - radial * radialVelocity;
  const float tangentLength = length(tangentVector);
  if (tangentLength < 1e-5) return vec3(0.0);
  const vec3 tangent = tangentVector / tangentLength;
  const float angularMomentum = observerRadius * tangentLength;
  GeodesicState state = GeodesicState(observerRadius, radialVelocity, 0.0);
  vec3 previousPoint = radial * observerRadius;
  bool diskHit = false;
  float diskRadius = 0.0;
  bool escaped = false;
  const float step = 0.10;
  for (uint iteration = 0u; iteration < 1024u; ++iteration) {
    state = rk4(state, mass, angularMomentum, step);
    if (isnan(state.radius) || isinf(state.radius) || isnan(state.radialVelocity) || isinf(state.radialVelocity) || state.radius <= 0.0) return vec3(0.0);
    if (state.radius <= 2.0 * mass * (1.0 + 1e-4)) return vec3(0.0);
    const vec3 orbitalDirection = radial * cos(state.azimuth) + tangent * sin(state.azimuth);
    const vec3 point = orbitalDirection * state.radius;
    if (!diskHit && previousPoint.z * point.z <= 0.0 && state.radius >= 3.2 * mass && state.radius <= 17.0 * mass) {
      diskHit = true;
      diskRadius = state.radius;
    }
    previousPoint = point;
    if (iteration > 2u && state.radius >= observerRadius && state.radialVelocity > 0.0) {
      escaped = true;
      break;
    }
  }
  if (!escaped) return vec3(0.0);
  const vec3 escapedDirection = normalize(previousPoint);
  const vec2 source = vec2(
      atan(escapedDirection.y, escapedDirection.x) / (2.0 * 3.14159265359) + 0.5,
      asin(clamp(escapedDirection.z, -1.0, 1.0)) / 3.14159265359 + 0.5);
  vec3 radiance = celestialRadiance(source);
  if (diskHit) {
    const float disk = (1.0 - smoothstep(4.2 * mass, 17.0 * mass, diskRadius)) * smoothstep(3.2 * mass, 4.0 * mass, diskRadius);
    const float beaming = pow(max(0.08, 1.0 + 0.55 * tangent.y), 3.0);
    const float temperature = pow(4.0 * mass / max(diskRadius, 4.0 * mass), 0.75);
    radiance += vec3(2.3, 0.54, 0.08) * disk * temperature * beaming * max(frame.diskGain, 0.0);
  }
  return radiance;
}

vec2 kerrPotentials(vec4 state, vec2 conserved, float mass, float spin) {
  const float radius = state.x;
  const float polar = state.y;
  const float radius2 = radius * radius;
  const float delta = radius2 - 2.0 * mass * radius + spin * spin;
  const float sine2 = max(sin(polar) * sin(polar), 1e-7);
  const float cosine2 = cos(polar) * cos(polar);
  const float axialMomentum = conserved.x;
  const float carter = conserved.y;
  const float p = radius2 + spin * spin - spin * axialMomentum;
  const float shiftedMomentum = axialMomentum - spin;
  return vec2(
      p * p - delta * (shiftedMomentum * shiftedMomentum + carter),
      carter + spin * spin * cosine2 - axialMomentum * axialMomentum * cosine2 / sine2);
}

vec4 kerrDerivative(vec4 state, vec2 conserved, vec2 signs, float mass, float spin) {
  const float radius = state.x;
  const float polar = state.y;
  const float radius2 = radius * radius;
  const float sine2 = max(sin(polar) * sin(polar), 1e-7);
  const float cosine2 = cos(polar) * cos(polar);
  const float sigma = max(radius2 + spin * spin * cosine2, 1e-7);
  const float delta = max(radius2 - 2.0 * mass * radius + spin * spin, 1e-6);
  const float p = radius2 + spin * spin - spin * conserved.x;
  const vec2 potential = max(kerrPotentials(state, conserved, mass, spin), vec2(0.0));
  return vec4(
      signs.x * sqrt(potential.x) / sigma,
      signs.y * sqrt(potential.y) / sigma,
      (conserved.x / sine2 - spin + spin * p / delta) / sigma,
      (-spin * (spin * sine2 - conserved.x) + (radius2 + spin * spin) * p / delta) / sigma);
}

vec4 kerrRk4(vec4 state, vec2 conserved, vec2 signs, float mass, float spin, float step) {
  const vec4 k1 = kerrDerivative(state, conserved, signs, mass, spin);
  const vec4 k2 = kerrDerivative(state + 0.5 * step * k1, conserved, signs, mass, spin);
  const vec4 k3 = kerrDerivative(state + 0.5 * step * k2, conserved, signs, mass, spin);
  const vec4 k4 = kerrDerivative(state + step * k3, conserved, signs, mass, spin);
  return state + step * (k1 + 2.0 * k2 + 2.0 * k3 + k4) / 6.0;
}

struct KerrTrace {
  vec2 source;
  vec3 diskRadiance;
  float status;  // 1 = captured, 2 = escaped, 3 = invalid
};

float progradeIsco(float mass, float spin) {
  const float normalizedSpin = clamp(spin / mass, -0.998, 0.998);
  const float z1 = 1.0 + pow(1.0 - normalizedSpin * normalizedSpin, 1.0 / 3.0) *
      (pow(1.0 + normalizedSpin, 1.0 / 3.0) + pow(1.0 - normalizedSpin, 1.0 / 3.0));
  const float z2 = sqrt(3.0 * normalizedSpin * normalizedSpin + z1 * z1);
  return mass * (3.0 + z2 - sign(normalizedSpin + 1e-7) *
      sqrt(max(0.0, (3.0 - z1) * (3.0 + z1 + 2.0 * z2))));
}

float asymmetricGaussian(float wavelength, float mean, float leftWidth, float rightWidth) {
  const float width = wavelength < mean ? leftWidth : rightWidth;
  const float value = (wavelength - mean) / width;
  return exp(-0.5 * value * value);
}

vec3 cieMatching(float wavelength) {
  const float x = 1.056 * asymmetricGaussian(wavelength, 599.8, 37.9, 31.0) +
      0.362 * asymmetricGaussian(wavelength, 442.0, 16.0, 26.7) -
      0.065 * asymmetricGaussian(wavelength, 501.1, 20.4, 26.2);
  const float y = 0.821 * asymmetricGaussian(wavelength, 568.8, 46.9, 40.5) +
      0.286 * asymmetricGaussian(wavelength, 530.9, 16.3, 31.1);
  const float z = 1.217 * asymmetricGaussian(wavelength, 437.0, 11.8, 36.0) +
      0.681 * asymmetricGaussian(wavelength, 459.0, 26.0, 13.8);
  return max(vec3(x, y, z), vec3(0.0));
}

vec3 redshiftedThermalRgb(float temperatureKelvin, float frequencyShift) {
  const float wavelengths[6] = float[6](400.0, 460.0, 520.0, 580.0, 640.0, 700.0);
  vec3 xyz = vec3(0.0);
  for (uint band = 0u; band < 6u; ++band) {
    const float observedWavelength = wavelengths[band];
    const float emittedWavelength = frequencyShift * observedWavelength;
    const float exponent = 1.4387769e7 / max(emittedWavelength * temperatureKelvin, 1.0);
    const float planckFrequency = 1.0 /
        max(pow(emittedWavelength, 3.0) * (exp(min(exponent, 80.0)) - 1.0), 1e-30);
    xyz += pow(frequencyShift, 3.0) * planckFrequency * cieMatching(observedWavelength);
  }
  const vec3 rgb = max(vec3(
      3.2406 * xyz.x - 1.5372 * xyz.y - 0.4986 * xyz.z,
      -0.9689 * xyz.x + 1.8758 * xyz.y + 0.0415 * xyz.z,
      0.0557 * xyz.x - 0.2040 * xyz.y + 1.0570 * xyz.z), vec3(0.0));
  return rgb / max(max(rgb.r, rgb.g), max(rgb.b, 1e-20));
}

KerrTrace traceKerr(vec2 imagePlane, bool shadeDisk) {
  const float mass = max(frame.mass, 0.2);
  const float spin = clamp(frame.spin, -0.998 * mass, 0.998 * mass);
  const float observerRadius = 52.0 * mass;
  const float observerPolar = clamp(frame.observerInclination, 0.08, 3.0615);
  const float sineObserver = sin(observerPolar);
  const float cosineObserver = cos(observerPolar);
  const float axialMomentum = -imagePlane.x * sineObserver;
  const float carter = imagePlane.y * imagePlane.y +
      cosineObserver * cosineObserver * (imagePlane.x * imagePlane.x - spin * spin);
  const vec2 conserved = vec2(axialMomentum, carter);
  vec2 signs = vec2(-1.0, imagePlane.y >= 0.0 ? 1.0 : -1.0);
  vec4 state = vec4(observerRadius, observerPolar, 0.0, 0.0);
  const float horizon = mass + sqrt(max(0.0, mass * mass - spin * spin));
  const float diskInner = max(progradeIsco(mass, spin), horizon * 1.08);
  const float diskOuter = 13.5 * mass;
  vec3 diskRadiance = vec3(0.0);
  float diskTransmittance = 1.0;
  uint diskIntersections = 0u;
  float previousPolar = state.y;
  float step = 0.07 * mass;
  // The observer is 52M away, so even a weakly deflected escaping ray needs
  // slightly more than 104M of affine travel to return to the escape sphere.
  // This bounded preview profile covers 133M without crossing the Metal GPU
  // watchdog threshold seen with a substantially longer command buffer.
  for (uint iteration = 0u; iteration < 1700u; ++iteration) {
    if (state.x <= horizon * 1.0008) return KerrTrace(vec2(0.0), diskRadiance, 1.0);
    if (iteration > 3u && signs.x > 0.0 && state.x >= observerRadius) {
      const vec2 source = vec2(
          fract(state.z / (2.0 * 3.14159265359) + 0.5),
          clamp(state.y / 3.14159265359, 0.0, 1.0));
      return KerrTrace(source, diskRadiance, 2.0);
    }
    const vec2 currentPotential = kerrPotentials(state, conserved, mass, spin);
    const float radialMargin = abs(currentPotential.x) / max(pow(state.x, 4.0), 1.0);
    const float polarMargin = abs(currentPotential.y) /
        max(1.0, conserved.y + spin * spin + conserved.x * conserved.x);
    if (min(radialMargin, polarMargin) < 2e-4) step = max(0.004 * mass, step * 0.65);
    const vec4 coarseCandidate = kerrRk4(state, conserved, signs, mass, spin, step);
    vec4 candidate = coarseCandidate;
    float localError = 0.0;
    if (shadeDisk) {
      const vec4 halfCandidate = kerrRk4(state, conserved, signs, mass, spin, 0.5 * step);
      candidate = kerrRk4(halfCandidate, conserved, signs, mass, spin, 0.5 * step);
      const vec4 errorScale = max(abs(candidate), vec4(1.0));
      localError = max(max(abs(candidate.x - coarseCandidate.x) / errorScale.x,
                           abs(candidate.y - coarseCandidate.y) / errorScale.y),
                       max(abs(candidate.z - coarseCandidate.z) / errorScale.z,
                           abs(candidate.w - coarseCandidate.w) / errorScale.w));
    }
    if (any(isnan(candidate)) || any(isinf(candidate))) {
      return KerrTrace(vec2(0.0), diskRadiance, 3.0);
    }
    if (shadeDisk && localError > 2e-5 && step > 0.004 * mass) {
      step = max(0.004 * mass, step * 0.5);
      continue;
    }
    if (state.x > horizon * 1.0008 && candidate.x <= horizon * 1.0008) {
      float low = 0.0;
      float high = 1.0;
      for (uint rootIteration = 0u; rootIteration < 12u; ++rootIteration) {
        const float fraction = 0.5 * (low + high);
        const vec4 crossing = kerrRk4(state, conserved, signs, mass, spin, step * fraction);
        if (crossing.x > horizon * 1.0008) low = fraction;
        else high = fraction;
      }
      return KerrTrace(vec2(0.0), diskRadiance, 1.0);
    }
    const vec2 candidatePotential = kerrPotentials(candidate, conserved, mass, spin);
    if (candidatePotential.x < 0.0) {
      signs.x = -signs.x;
      continue;
    }
    if (candidatePotential.y < 0.0) {
      signs.y = -signs.y;
      continue;
    }
    const bool equatorCrossing =
        (previousPolar - 0.5 * 3.14159265359) * (candidate.y - 0.5 * 3.14159265359) <= 0.0 &&
        abs(candidate.y - previousPolar) > 1e-7;
    if (shadeDisk && equatorCrossing) {
      float low = 0.0;
      float high = 1.0;
      vec4 crossing = state;
      const float initialSide = state.y - 0.5 * 3.14159265359;
      for (uint rootIteration = 0u; rootIteration < 12u; ++rootIteration) {
        const float fraction = 0.5 * (low + high);
        crossing = kerrRk4(state, conserved, signs, mass, spin, step * fraction);
        const float side = crossing.y - 0.5 * 3.14159265359;
        if ((initialSide <= 0.0 && side <= 0.0) || (initialSide >= 0.0 && side >= 0.0)) low = fraction;
        else high = fraction;
      }
      const float crossingRadius = crossing.x;
      if (crossingRadius < diskInner || crossingRadius > diskOuter) {
        previousPolar = candidate.y;
        state = candidate;
        continue;
      }
      const float radius = crossingRadius / mass;
      const float omega = 1.0 / (pow(radius, 1.5) + spin / mass);
      const float denominator = max(0.08, pow(radius, 1.5) - 3.0 * sqrt(radius) + 2.0 * spin / mass);
      const float emitterTime = (pow(radius, 1.5) + spin / mass) / sqrt(pow(radius, 1.5) * denominator);
      const float frequencyShift = clamp(1.0 / max(0.05, emitterTime * (1.0 - omega * axialMomentum / mass)), 0.08, 3.5);
      const float innerRatio = diskInner / crossingRadius;
      const float temperatureKelvin = 32000.0 * pow(innerRatio, 0.75) *
          pow(max(0.0, 1.0 - sqrt(innerRatio)), 0.25);
      const float radialWindow = smoothstep(diskInner, diskInner * 1.12, crossingRadius) *
          (1.0 - smoothstep(diskOuter * 0.72, diskOuter, crossingRadius));
      const float turbulence = 0.94 + 0.06 * sin(7.0 * log(max(radius, 1.0)));
      const float emissivity = radialWindow * turbulence;
      const vec3 thermal = redshiftedThermalRgb(temperatureKelvin, frequencyShift);
      const float bolometricTransfer = pow(frequencyShift, 4.0) *
          pow(max(temperatureKelvin, 1000.0) / 14000.0, 4.0);
      const float thickness = 0.14 * mass;
      const float opticalDepth = 2.2 * clamp(2.0 * thickness / crossingRadius, 0.02, 1.0);
      const float absorbed = 1.0 - exp(-opticalDepth);
      const float coronaScatter = absorbed * 0.22 * (1.0 - exp(-0.08));
      diskRadiance += diskTransmittance * (absorbed + coronaScatter) * thermal * emissivity *
          bolometricTransfer * max(frame.diskGain, 0.0) * 0.34;
      diskTransmittance *= exp(-opticalDepth);
      ++diskIntersections;
      if (diskTransmittance < 0.002 || diskIntersections >= 6u) {
        return KerrTrace(vec2(0.0), diskRadiance, 1.0);
      }
    }
    previousPolar = candidate.y;
    state = candidate;
    if (shadeDisk && localError < 1e-6) step = min(0.09 * mass, step * 1.25);
  }
  return KerrTrace(vec2(0.0), diskRadiance, 3.0);
}

vec2 wrappedSourceDelta(vec2 target, vec2 origin) {
  vec2 delta = target - origin;
  delta.x = fract(delta.x + 0.5) - 0.5;
  return delta;
}

vec3 filteredCelestialRadiance(
    vec2 source, vec2 sourceDx, vec2 sourceDy,
    float sourceAreaScale, float bundleShear) {
  const vec2 grid = vec2(71.0, 37.0);
  const vec2 gridPoint = source * grid;
  const ivec2 baseCell = ivec2(floor(gridPoint));
  vec2 bundleX = sourceDx * grid;
  vec2 bundleY = sourceDy * grid;
  const float maximumFootprint = 0.34;
  if (length(bundleX) > maximumFootprint) bundleX *= maximumFootprint / length(bundleX);
  if (length(bundleY) > maximumFootprint) bundleY *= maximumFootprint / length(bundleY);

  // A pixel is a finite box, so its source-space covariance is J J^T / 12.
  // The determinant ratio preserves each procedural star's integrated energy
  // as a highly sheared bundle spreads it over a larger source footprint.
  const float baseSigma = 0.028;
  const float baseVariance = baseSigma * baseSigma;
  const float footprintScale = mix(1.0, 1.25, bundleShear) / 12.0;
  const float covarianceXX = baseVariance + footprintScale *
      (bundleX.x * bundleX.x + bundleY.x * bundleY.x);
  const float covarianceXY = footprintScale *
      (bundleX.x * bundleX.y + bundleY.x * bundleY.y);
  const float covarianceYY = baseVariance + footprintScale *
      (bundleX.y * bundleX.y + bundleY.y * bundleY.y);
  const float determinant = max(
      covarianceXX * covarianceYY - covarianceXY * covarianceXY,
      baseVariance * baseVariance);
  const mat2 inverseCovariance = mat2(
      covarianceYY, -covarianceXY,
      -covarianceXY, covarianceXX) / determinant;
  const float conservedPeak = baseVariance / sqrt(determinant);

  vec3 stars = vec3(0.0);
  for (int offsetY = -1; offsetY <= 1; ++offsetY) {
    const int unwrappedY = baseCell.y + offsetY;
    if (unwrappedY < 0 || unwrappedY >= int(grid.y)) continue;
    for (int offsetX = -1; offsetX <= 1; ++offsetX) {
      const int unwrappedX = baseCell.x + offsetX;
      const float wrappedX = mod(float(unwrappedX), grid.x);
      const vec2 canonicalCell = vec2(wrappedX, float(unwrappedY));
      const vec2 starPosition = vec2(float(unwrappedX), float(unwrappedY)) +
          vec2(hash21(canonicalCell), hash21(canonicalCell + 19.17));
      const vec2 delta = gridPoint - starPosition;
      const float exponent = -0.5 * dot(delta, inverseCovariance * delta);
      const float starPresence = smoothstep(0.86, 0.92, hash21(canonicalCell + 31.73));
      const float star = starPresence * conservedPeak * exp(max(exponent, -32.0));
      const float temperature = 0.45 + 0.55 * hash21(canonicalCell + 7.2);
      stars += star * mix(
          vec3(0.48, 0.74, 2.0), vec3(2.2, 0.88, 0.34), temperature);
    }
  }
  const vec3 background = vec3(0.006, 0.010, 0.030) +
      0.008 * vec3(0.4, 0.22, 0.62) * (0.5 + 0.5 * sin(source.y * 19.0));
  return background + stars;
}

vec3 kerrRadiance(vec2 uv) {
  const float aspect = frame.width / max(frame.height, 1.0);
  const vec2 screen = (uv - 0.5) * vec2(2.0 * aspect, 2.0) / max(frame.cameraScale, 0.1);
  const vec2 imagePlane = screen * (17.0 * max(frame.mass, 0.2));
  const KerrTrace central = traceKerr(imagePlane, true);
  if (central.status < 1.5) return central.diskRadiance;
  if (central.status > 2.5) return vec3(0.0);

  const ivec2 footprintPixel = clamp(
      ivec2(uv * vec2(frame.width, frame.height)),
      ivec2(0),
      ivec2(int(frame.width) - 1, int(frame.height) - 1));
  const vec4 transportedFootprint = imageLoad(kerrBundleFootprint, footprintPixel);
  const vec2 sourceDx = transportedFootprint.xy * max(frame.bundleScale, 0.0);
  const vec2 sourceDy = transportedFootprint.zw * max(frame.bundleScale, 0.0);
  const float sourceAreaScale = abs(sourceDx.x * sourceDy.y - sourceDx.y * sourceDy.x);
  const float trace = dot(sourceDx, sourceDx) + dot(sourceDy, sourceDy);
  const float discriminant = sqrt(max(0.0, trace * trace - 4.0 * sourceAreaScale * sourceAreaScale));
  const float maximumSingular = sqrt(max(0.0, 0.5 * (trace + discriminant)));
  const float minimumSingular = sqrt(max(0.0, 0.5 * (trace - discriminant)));
  const float bundleShear = (maximumSingular - minimumSingular) /
      max(maximumSingular + minimumSingular, 1e-7);
  return filteredCelestialRadiance(
      central.source, sourceDx, sourceDy, sourceAreaScale, bundleShear) + central.diskRadiance;
}

float volumeDensity(vec3 point) {
  const vec3 animated = point + vec3(
      0.18 * sin(frame.timeSeconds * 0.7 + point.y * 2.0),
      -0.35 * frame.timeSeconds,
      0.14 * cos(frame.timeSeconds * 0.5 + point.y * 1.7));
  const float column = exp(-3.4 * dot(animated.xz, animated.xz));
  const float cap = smoothstep(-1.4, -0.8, animated.y) *
      (1.0 - smoothstep(0.8, 1.7, animated.y));
  const float billow = 0.55 + 0.45 * sin(5.1 * animated.x + 3.7 * animated.y) *
      sin(4.3 * animated.z - 2.9 * animated.y);
  return max(0.0, column * cap * (0.58 + 0.42 * billow));
}

vec3 volumeRadiance(vec2 uv) {
  const float aspect = frame.width / max(frame.height, 1.0);
  const vec2 screen = (uv - 0.5) * vec2(2.0 * aspect, 2.0);
  const vec3 origin = vec3(0.0, 0.15, 3.4);
  const vec3 direction = normalize(vec3(screen.x, screen.y, -2.2));
  const vec3 lightDirection = normalize(vec3(-0.55, 0.82, 0.38));
  float distanceAlongRay = 0.0;
  float transmittance = 1.0;
  vec3 radiance = vec3(0.0);
  for (uint step = 0u; step < 128u && transmittance > 0.01; ++step) {
    const vec3 point = origin + direction * distanceAlongRay;
    const float density = volumeDensity(point);
    if (density < 0.008) {
      distanceAlongRay += 0.07;
      continue;
    }
    float lightTransmittance = 1.0;
    for (uint shadowStep = 1u; shadowStep <= 8u; ++shadowStep) {
      const float shadowDensity = volumeDensity(point + lightDirection * (0.08 * float(shadowStep)));
      lightTransmittance *= exp(-shadowDensity * 0.11);
    }
    const float absorbed = 1.0 - exp(-density * 0.12);
    const float forward = 0.45 + 0.55 * pow(max(dot(direction, lightDirection), 0.0), 4.0);
    const vec3 scattering =
        mix(vec3(0.18, 0.24, 0.32), vec3(1.0, 0.64, 0.28), density) *
        lightTransmittance * (0.55 + 0.45 * forward);
    radiance += transmittance * absorbed * scattering;
    transmittance *= 1.0 - absorbed;
    distanceAlongRay += 0.035;
  }
  const vec3 background = mix(vec3(0.012, 0.017, 0.028), vec3(0.07, 0.10, 0.15), uv.y);
  return radiance * 3.0 + transmittance * background;
}

void main() {
  const uvec2 pixel = gl_GlobalInvocationID.xy;
  if (pixel.x >= uint(frame.width) || pixel.y >= uint(frame.height)) return;
  vec2 jitter = vec2(0.0);
  if (frame.mode > 0.5) {
    const float rotation = hash21(vec2(pixel) + 0.37);
    jitter = fract(vec2(0.754877666, 0.569840296) * (frame.sampleIndex + 1.0) + rotation) - 0.5;
  }
  const vec2 uv = (vec2(pixel) + 0.5 + jitter) / vec2(frame.width, frame.height);
  vec3 radiance;
  if (frame.mode > 2.5) {
    radiance = volumeRadiance(uv);
  } else if (frame.mode > 1.5) {
    radiance = kerrRadiance(uv);
  } else if (frame.mode > 0.5) {
    radiance = schwarzschildRadiance(uv);
  } else {
    const float aspect = frame.width / max(frame.height, 1.0);
    const vec2 p = (uv - 0.5) * vec2(8.0 * aspect, 8.0);
    const float phase = 2.4 * p.x - 2.6 * frame.timeSeconds;
    const float rings = 0.18 * sin(1.35 * length(p) - 0.7 * frame.timeSeconds);
    const float t = 0.5 + 0.5 * tanh(sin(phase) + rings);
    radiance = 2.25 * vec3(
        0.025 + 0.91 * pow(t, 1.55),
        0.055 + 0.54 * sin(t * 1.47),
        0.13 + 0.70 * (1.0 - t) * (1.0 - t));
  }
  if (frame.mode > 0.5 && frame.sampleIndex > 0.5) {
    const vec3 previous = imageLoad(outputRadiance, ivec2(pixel)).rgb;
    radiance = (previous * frame.sampleIndex + radiance) / (frame.sampleIndex + 1.0);
  }
  imageStore(outputRadiance, ivec2(pixel), vec4(radiance, 1.0));
}
