#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer CurrentField { float values[]; } currentField;
layout(std430, binding = 1) readonly buffer PreviousField { float values[]; } previousField;
layout(std430, binding = 2) writeonly buffer NextField { float values[]; } nextField;
layout(std140, binding = 3) uniform StepParameters {
  uint width;
  uint height;
  float coefficient;
  float padding;
} parameters;

void main() {
  uvec2 pixel = gl_GlobalInvocationID.xy;
  if (pixel.x >= parameters.width || pixel.y >= parameters.height) return;
  uint index = pixel.y * parameters.width + pixel.x;
  if (pixel.x == 0u || pixel.y == 0u || pixel.x + 1u == parameters.width || pixel.y + 1u == parameters.height) {
    nextField.values[index] = 0.0;
    return;
  }
  float laplace = currentField.values[index - 1u] + currentField.values[index + 1u] +
      currentField.values[index - parameters.width] + currentField.values[index + parameters.width] -
      4.0 * currentField.values[index];
  nextField.values[index] = 2.0 * currentField.values[index] - previousField.values[index] +
      parameters.coefficient * laplace;
}
