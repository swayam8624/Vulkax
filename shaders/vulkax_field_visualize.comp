#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer FieldInput {
  float values[];
} inputField;

layout(binding = 1, rgba16f) uniform writeonly image2D outputRadiance;

layout(std140, binding = 2) uniform FieldParameters {
  uint width;
  uint height;
  float time;
  float amplitude;
  float wavenumber;
  float angularFrequency;
  vec2 padding;
} parameters;

vec3 palette(float normalized) {
  float value = clamp(normalized, 0.0, 1.0);
  float shadow = pow(value, 0.72);
  return vec3(
      0.025 + 0.91 * pow(shadow, 1.55),
      0.055 + 0.54 * sin(shadow * 1.47),
      0.13 + 0.70 * (1.0 - shadow) * (1.0 - shadow));
}

void main() {
  uvec2 pixel = gl_GlobalInvocationID.xy;
  if (pixel.x >= parameters.width || pixel.y >= parameters.height) return;
  uint index = pixel.y * parameters.width + pixel.x;
  float normalized = 0.5 + 0.5 * tanh(inputField.values[index]);
  imageStore(outputRadiance, ivec2(pixel), vec4(palette(normalized), 1.0));
}
