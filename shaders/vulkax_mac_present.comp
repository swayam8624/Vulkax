#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Radiance {
    float values[];
} radiance;
layout(set = 0, binding = 1, rgba16f) uniform image2D outputImage;

layout(push_constant) uniform PresentPush {
    uint width;
    uint height;
} pushData;

void main() {
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pushData.width || pixel.y >= pushData.height) return;
    const uint index = (pixel.y * pushData.width + pixel.x) * 4u;
    vec4 value = vec4(
        radiance.values[index],
        radiance.values[index + 1u],
        radiance.values[index + 2u],
        radiance.values[index + 3u]);
    if (any(isnan(value)) || any(isinf(value))) value = vec4(0.0, 0.0, 0.0, 1.0);
    imageStore(outputImage, ivec2(pixel), value);
}
