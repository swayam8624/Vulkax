#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ParticleState {
  vec4 positionMass; // xy position, z mass
  vec4 velocity;     // xy velocity
};

layout(std430, binding = 0) readonly buffer InputParticles { ParticleState values[]; } inputParticles;
layout(std430, binding = 1) writeonly buffer OutputParticles { ParticleState values[]; } outputParticles;

layout(std140, binding = 2) uniform ParticleParameters {
  uvec2 countPhase;
  vec2 countPhasePadding;
  vec4 physical;
} parameters;

vec2 acceleration(uint target) {
  vec2 result = vec2(0.0);
  vec2 targetPosition = inputParticles.values[target].positionMass.xy;
  for (uint source = 0u; source < parameters.countPhase.x; ++source) {
    if (source == target) continue;
    vec2 delta = inputParticles.values[source].positionMass.xy - targetPosition;
    float inverseDistance = inversesqrt(dot(delta, delta) + parameters.physical.z * parameters.physical.z);
    float scale = parameters.physical.y * inputParticles.values[source].positionMass.z *
        inverseDistance * inverseDistance * inverseDistance;
    result += delta * scale;
  }
  return result;
}

void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index >= parameters.countPhase.x) return;

  ParticleState source = inputParticles.values[index];
  vec2 accelerationNow = acceleration(index);
  ParticleState destination = source;
  if (parameters.countPhase.y == 0u) {
    // Kick then drift. The output becomes the input for the second kick pass.
    destination.velocity.xy = source.velocity.xy + 0.5 * parameters.physical.x * accelerationNow;
    destination.positionMass.xy = source.positionMass.xy + parameters.physical.x * destination.velocity.xy;
  } else {
    // The second pass evaluates acceleration from the drifted positions.
    destination.velocity.xy = source.velocity.xy + 0.5 * parameters.physical.x * accelerationNow;
  }
  outputParticles.values[index] = destination;
}
