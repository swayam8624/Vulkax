#version 450

layout(local_size_x = 256) in;

struct RayState {
    vec4 position;          // radius, polar angle, azimuth, coordinate time
    vec4 conservedSigns;    // axial momentum, Carter constant, radial sign, polar sign
    vec4 integration;       // affine distance, target distance, step, maximum local error
    uvec4 counters;         // status, accepted steps, turning points, padding
};

layout(set = 0, binding = 0, std430) buffer RayStates { RayState values[]; } rays;
layout(set = 0, binding = 1, std430) buffer ActiveA { uint values[]; } activeA;
layout(set = 0, binding = 2, std430) buffer ActiveB { uint values[]; } activeB;
layout(set = 0, binding = 3, std430) buffer Flags { uint values[]; } flags;
layout(set = 0, binding = 4, std430) buffer Offsets { uint values[]; } offsets;
layout(set = 0, binding = 5, std430) buffer Control {
    uint activeCount;
    uint previousCount;
    uint maximumCount;
    uint iterations;
} control;
layout(set = 0, binding = 6, std430) buffer IndirectCommand {
    uint x;
    uint y;
    uint z;
} indirectCommand;
layout(set = 0, binding = 7, std430) buffer BlockSums { uint values[]; } blockSums;
layout(set = 0, binding = 8, std430) buffer BlockOffsets { uint values[]; } blockOffsets;

layout(push_constant) uniform Push {
    uint phase;
    uint sourceQueue;
    float mass;
    float spin;
    float horizon;
    float minimumStep;
    float maximumStep;
    float errorTolerance;
} pushData;

shared uint scanA[1024];
shared uint scanB[1024];

uint activeRay(uint slot) {
    return pushData.sourceQueue == 0 ? activeA.values[slot] : activeB.values[slot];
}

void writeNext(uint slot, uint rayIndex) {
    if (pushData.sourceQueue == 0)
        activeB.values[slot] = rayIndex;
    else
        activeA.values[slot] = rayIndex;
}

vec2 kerrPotentials(vec4 state, vec2 conserved) {
    const float radius = state.x;
    const float polar = state.y;
    const float radius2 = radius * radius;
    const float delta = radius2 - 2.0 * pushData.mass * radius + pushData.spin * pushData.spin;
    const float sine2 = max(sin(polar) * sin(polar), 1e-7);
    const float cosine2 = cos(polar) * cos(polar);
    const float p = radius2 + pushData.spin * pushData.spin - pushData.spin * conserved.x;
    const float shifted = conserved.x - pushData.spin;
    return vec2(
        p * p - delta * (shifted * shifted + conserved.y),
        conserved.y + pushData.spin * pushData.spin * cosine2 -
            conserved.x * conserved.x * cosine2 / sine2);
}

vec4 kerrDerivative(vec4 state, vec2 conserved, vec2 signs) {
    const float radius = state.x;
    const float polar = state.y;
    const float radius2 = radius * radius;
    const float sine2 = max(sin(polar) * sin(polar), 1e-7);
    const float cosine2 = cos(polar) * cos(polar);
    const float sigma = max(radius2 + pushData.spin * pushData.spin * cosine2, 1e-7);
    const float delta = max(
        radius2 - 2.0 * pushData.mass * radius + pushData.spin * pushData.spin, 1e-7);
    const float p = radius2 + pushData.spin * pushData.spin - pushData.spin * conserved.x;
    const vec2 potential = max(kerrPotentials(state, conserved), vec2(0.0));
    return vec4(
        signs.x * sqrt(potential.x) / sigma,
        signs.y * sqrt(potential.y) / sigma,
        (conserved.x / sine2 - pushData.spin + pushData.spin * p / delta) / sigma,
        (-pushData.spin * (pushData.spin * sine2 - conserved.x) +
            (radius2 + pushData.spin * pushData.spin) * p / delta) / sigma);
}

vec4 kerrRk4(vec4 state, vec2 conserved, vec2 signs, float step) {
    const vec4 k1 = kerrDerivative(state, conserved, signs);
    const vec4 k2 = kerrDerivative(state + 0.5 * step * k1, conserved, signs);
    const vec4 k3 = kerrDerivative(state + 0.5 * step * k2, conserved, signs);
    const vec4 k4 = kerrDerivative(state + step * k3, conserved, signs);
    return state + step * (k1 + 2.0 * k2 + 2.0 * k3 + k4) / 6.0;
}

bool finiteVector(vec4 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

void integrateActiveRay() {
    const uint slot = gl_GlobalInvocationID.x;
    if (slot >= control.activeCount) return;
    const uint rayIndex = activeRay(slot);
    RayState ray = rays.values[rayIndex];
    if (ray.position.x <= pushData.horizon) {
        ray.counters.x = 1u;
    } else if (ray.integration.x >= ray.integration.y) {
        ray.counters.x = 2u;
    } else {
        const vec2 conserved = ray.conservedSigns.xy;
        vec2 signs = ray.conservedSigns.zw;
        const vec2 potential = kerrPotentials(ray.position, conserved);
        if (potential.x < 0.0) {
            signs.x = -signs.x;
            ++ray.counters.z;
        }
        if (potential.y < 0.0) {
            signs.y = -signs.y;
            ++ray.counters.z;
        }
        const float remaining = ray.integration.y - ray.integration.x;
        const float step = min(ray.integration.z, remaining);
        const vec4 coarse = kerrRk4(ray.position, conserved, signs, step);
        const vec4 midpoint = kerrRk4(ray.position, conserved, signs, 0.5 * step);
        const vec4 refined = kerrRk4(midpoint, conserved, signs, 0.5 * step);
        const vec4 scale = max(abs(refined), vec4(1.0));
        const vec4 relativeError = abs(refined - coarse) / scale;
        const float localError = max(max(relativeError.x, relativeError.y),
                                     max(relativeError.z, relativeError.w));
        ray.integration.w = max(ray.integration.w, localError);
        if (!finiteVector(refined) || isnan(localError) || isinf(localError)) {
            ray.counters.x = 3u;
        } else if (localError > pushData.errorTolerance && step > pushData.minimumStep) {
            ray.integration.z = max(pushData.minimumStep, 0.5 * step);
        } else {
            const vec2 refinedPotential = kerrPotentials(refined, conserved);
            if (refinedPotential.x < 0.0 || refinedPotential.y < 0.0) {
                if (refinedPotential.x < 0.0) signs.x = -signs.x;
                if (refinedPotential.y < 0.0) signs.y = -signs.y;
                ++ray.counters.z;
                ray.integration.z = max(pushData.minimumStep, 0.5 * step);
            } else {
                ray.position = refined;
                ray.integration.x += step;
                ++ray.counters.y;
                if (localError < pushData.errorTolerance * 0.08)
                    ray.integration.z = min(pushData.maximumStep, step * 1.35);
                if (ray.position.x <= pushData.horizon)
                    ray.counters.x = 1u;
                else if (ray.integration.x >= ray.integration.y - 1e-6)
                    ray.counters.x = 2u;
            }
        }
        ray.conservedSigns.zw = signs;
    }
    rays.values[rayIndex] = ray;
    flags.values[slot] = ray.counters.x == 0u ? 1u : 0u;
}

void scanActiveBlock() {
    const uint slot = gl_GlobalInvocationID.x;
    const uint lane = gl_LocalInvocationID.x;
    const uint value = slot < control.activeCount ? flags.values[slot] : 0u;
    scanA[lane] = value;
    barrier();
    bool sourceA = true;
    for (uint stride = 1u; stride < 256u; stride <<= 1u) {
        const uint own = sourceA ? scanA[lane] : scanB[lane];
        const uint preceding = lane >= stride ?
            (sourceA ? scanA[lane - stride] : scanB[lane - stride]) : 0u;
        if (sourceA)
            scanB[lane] = own + preceding;
        else
            scanA[lane] = own + preceding;
        barrier();
        sourceA = !sourceA;
    }
    const uint inclusive = sourceA ? scanA[lane] : scanB[lane];
    if (slot < control.activeCount) offsets.values[slot] = inclusive - value;
    barrier();
    if (lane == 255u) blockSums.values[gl_WorkGroupID.x] = inclusive;
}

void scanBlockSums() {
    const uint lane = gl_LocalInvocationID.x;
    const uint blockCount = (control.activeCount + 255u) / 256u;
    for (uint index = lane; index < 1024u; index += 256u)
        scanA[index] = index < blockCount ? blockSums.values[index] : 0u;
    barrier();
    bool sourceA = true;
    for (uint stride = 1u; stride < 1024u; stride <<= 1u) {
        for (uint index = lane; index < 1024u; index += 256u) {
            const uint own = sourceA ? scanA[index] : scanB[index];
            const uint preceding = index >= stride ?
                (sourceA ? scanA[index - stride] : scanB[index - stride]) : 0u;
            if (sourceA)
                scanB[index] = own + preceding;
            else
                scanA[index] = own + preceding;
        }
        barrier();
        sourceA = !sourceA;
    }
    for (uint index = lane; index < blockCount; index += 256u) {
        const uint inclusive = sourceA ? scanA[index] : scanB[index];
        blockOffsets.values[index] = inclusive - blockSums.values[index];
    }
    barrier();
    if (lane == 0u) {
        const uint nextCount = blockCount == 0u ? 0u :
            (sourceA ? scanA[blockCount - 1u] : scanB[blockCount - 1u]);
        control.previousCount = control.activeCount;
        control.activeCount = nextCount;
        ++control.iterations;
        indirectCommand.x = (nextCount + 255) / 256;
        indirectCommand.y = 1;
        indirectCommand.z = 1;
    }
}

void scatterActiveRays() {
    const uint slot = gl_GlobalInvocationID.x;
    if (slot >= control.previousCount || flags.values[slot] == 0) return;
    const uint outputSlot = blockOffsets.values[slot / 256u] + offsets.values[slot];
    writeNext(outputSlot, activeRay(slot));
}

void main() {
    if (pushData.phase == 0)
        integrateActiveRay();
    else if (pushData.phase == 1)
        scanActiveBlock();
    else if (pushData.phase == 2)
        scanBlockSums();
    else
        scatterActiveRays();
}
