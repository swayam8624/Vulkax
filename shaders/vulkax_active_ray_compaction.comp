#version 450

layout(local_size_x = 256) in;

struct RayState {
    vec4 position;          // radius, polar angle, azimuth, coordinate time
    vec4 conservedSigns;    // axial momentum, Carter constant, radial sign, polar sign
    vec4 integration;       // affine distance, target distance, step, maximum local error
    vec4 jacobiPosition;    // coordinate time, radius, polar angle, azimuth
    vec4 jacobiWave;
    vec4 horizontal;
    vec4 horizontalDerivative;
    vec4 vertical;
    vec4 verticalDerivative;
    vec4 jacobiDiagnostics; // maximum tidal acceleration, reserved
    uvec4 counters;         // status, accepted steps, turning points, Jacobi active
};

layout(set = 0, binding = 0, std430) buffer RayStates { RayState values[]; } rays;
layout(set = 0, binding = 1, std430) buffer ActiveA { uint values[]; } activeA;
layout(set = 0, binding = 2, std430) buffer ActiveB { uint values[]; } activeB;
layout(set = 0, binding = 3, std430) buffer Flags { uint values[]; } flags;
layout(set = 0, binding = 4, std430) buffer Offsets { uint values[]; } offsets;
layout(set = 0, binding = 5, std430) buffer Control {
    uint activeCount;
    uint previousCount;
    uint maximumCount;
    uint iterations;
} control;
layout(set = 0, binding = 6, std430) buffer IndirectCommand {
    uint x;
    uint y;
    uint z;
} indirectCommand;
layout(set = 0, binding = 7, std430) buffer BlockSums { uint values[]; } blockSums;
layout(set = 0, binding = 8, std430) buffer BlockOffsets { uint values[]; } blockOffsets;

layout(push_constant) uniform Push {
    uint phase;
    uint sourceQueue;
    float mass;
    float spin;
    float horizon;
    float minimumStep;
    float maximumStep;
    float errorTolerance;
    uint jacobiRayCount;
    uint stepsPerDispatch;
    float observerRadius;
    uint terminateAtObserver;
} pushData;

shared uint scanA[1024];
shared uint scanB[1024];

uint activeRay(uint slot) {
    return pushData.sourceQueue == 0 ? activeA.values[slot] : activeB.values[slot];
}

void writeNext(uint slot, uint rayIndex) {
    if (pushData.sourceQueue == 0)
        activeB.values[slot] = rayIndex;
    else
        activeA.values[slot] = rayIndex;
}

vec2 kerrPotentials(vec4 state, vec2 conserved) {
    const float radius = state.x;
    const float polar = state.y;
    const float radius2 = radius * radius;
    const float delta = radius2 - 2.0 * pushData.mass * radius + pushData.spin * pushData.spin;
    const float sine2 = max(sin(polar) * sin(polar), 1e-7);
    const float cosine2 = cos(polar) * cos(polar);
    const float p = radius2 + pushData.spin * pushData.spin - pushData.spin * conserved.x;
    const float shifted = conserved.x - pushData.spin;
    return vec2(
        p * p - delta * (shifted * shifted + conserved.y),
        conserved.y + pushData.spin * pushData.spin * cosine2 -
            conserved.x * conserved.x * cosine2 / sine2);
}

vec4 kerrDerivative(vec4 state, vec2 conserved, vec2 signs) {
    const float radius = state.x;
    const float polar = state.y;
    const float radius2 = radius * radius;
    const float sine2 = max(sin(polar) * sin(polar), 1e-7);
    const float cosine2 = cos(polar) * cos(polar);
    const float sigma = max(radius2 + pushData.spin * pushData.spin * cosine2, 1e-7);
    const float delta = max(
        radius2 - 2.0 * pushData.mass * radius + pushData.spin * pushData.spin, 1e-7);
    const float p = radius2 + pushData.spin * pushData.spin - pushData.spin * conserved.x;
    const vec2 potential = max(kerrPotentials(state, conserved), vec2(0.0));
    return vec4(
        signs.x * sqrt(potential.x) / sigma,
        signs.y * sqrt(potential.y) / sigma,
        (conserved.x / sine2 - pushData.spin + pushData.spin * p / delta) / sigma,
        (-pushData.spin * (pushData.spin * sine2 - conserved.x) +
            (radius2 + pushData.spin * pushData.spin) * p / delta) / sigma);
}

vec4 kerrRk4(vec4 state, vec2 conserved, vec2 signs, float step) {
    const vec4 k1 = kerrDerivative(state, conserved, signs);
    const vec4 k2 = kerrDerivative(state + 0.5 * step * k1, conserved, signs);
    const vec4 k3 = kerrDerivative(state + 0.5 * step * k2, conserved, signs);
    const vec4 k4 = kerrDerivative(state + step * k3, conserved, signs);
    return state + step * (k1 + 2.0 * k2 + 2.0 * k3 + k4) / 6.0;
}

bool finiteVector(vec4 value);

struct Connection {
    mat4 gamma[4];
};

struct BundleState {
    vec4 position;
    vec4 wave;
    vec4 horizontal;
    vec4 horizontalDerivative;
    vec4 vertical;
    vec4 verticalDerivative;
};

mat4 kerrMetric(vec4 position) {
    const float radius = position.y;
    const float polar = clamp(position.z, 1e-4, 3.14149265);
    const float sine = sin(polar);
    const float cosine = cos(polar);
    const float sine2 = sine * sine;
    const float sigma = radius * radius + pushData.spin * pushData.spin * cosine * cosine;
    const float delta = radius * radius - 2.0 * pushData.mass * radius +
        pushData.spin * pushData.spin;
    mat4 metric = mat4(0.0);
    metric[0][0] = -(1.0 - 2.0 * pushData.mass * radius / sigma);
    metric[3][0] = -2.0 * pushData.mass * pushData.spin * radius * sine2 / sigma;
    metric[0][3] = metric[3][0];
    metric[1][1] = sigma / delta;
    metric[2][2] = sigma;
    metric[3][3] = sine2 * (radius * radius + pushData.spin * pushData.spin +
        2.0 * pushData.mass * pushData.spin * pushData.spin * radius * sine2 / sigma);
    return metric;
}

float coordinateStep(vec4 position, int coordinate) {
    if (coordinate == 0 || coordinate == 3) return 1e-4;
    return 2e-4 * max(1.0, abs(position[coordinate]));
}

mat4 metricDerivative(vec4 position, int coordinate) {
    if (coordinate == 0 || coordinate == 3) return mat4(0.0);
    const float step = coordinateStep(position, coordinate);
    vec4 positive = position;
    vec4 negative = position;
    positive[coordinate] += step;
    negative[coordinate] -= step;
    return (kerrMetric(positive) - kerrMetric(negative)) / (2.0 * step);
}

Connection kerrConnection(vec4 position) {
    Connection result;
    for (int mu = 0; mu < 4; ++mu) result.gamma[mu] = mat4(0.0);
    const mat4 inverseMetric = inverse(kerrMetric(position));
    mat4 derivatives[4];
    for (int coordinate = 0; coordinate < 4; ++coordinate)
        derivatives[coordinate] = metricDerivative(position, coordinate);
    for (int mu = 0; mu < 4; ++mu)
        for (int alpha = 0; alpha < 4; ++alpha)
            for (int beta = 0; beta < 4; ++beta)
                for (int sigma = 0; sigma < 4; ++sigma)
                    result.gamma[mu][beta][alpha] += 0.5 * inverseMetric[sigma][mu] *
                        (derivatives[alpha][beta][sigma] +
                         derivatives[beta][alpha][sigma] -
                         derivatives[sigma][beta][alpha]);
    return result;
}

Connection connectionDerivative(vec4 position, int coordinate) {
    Connection result;
    for (int mu = 0; mu < 4; ++mu) result.gamma[mu] = mat4(0.0);
    if (coordinate == 0 || coordinate == 3) return result;
    const float step = 2.0 * coordinateStep(position, coordinate);
    vec4 positive = position;
    vec4 negative = position;
    positive[coordinate] += step;
    negative[coordinate] -= step;
    const Connection upper = kerrConnection(positive);
    const Connection lower = kerrConnection(negative);
    for (int mu = 0; mu < 4; ++mu)
        result.gamma[mu] = (upper.gamma[mu] - lower.gamma[mu]) / (2.0 * step);
    return result;
}

float gammaValue(Connection connection, int mu, int alpha, int beta) {
    return connection.gamma[mu][beta][alpha];
}

float gammaDerivativeValue(
    Connection radialDerivative,
    Connection polarDerivative,
    int coordinate,
    int mu,
    int alpha,
    int beta) {
    if (coordinate == 1) return gammaValue(radialDerivative, mu, alpha, beta);
    if (coordinate == 2) return gammaValue(polarDerivative, mu, alpha, beta);
    return 0.0;
}

void transportDeviation(
    Connection center,
    Connection radialDerivative,
    Connection polarDerivative,
    vec4 wave,
    vec4 deviation,
    vec4 covariant,
    out vec4 deviationDerivative,
    out vec4 covariantDerivative,
    inout float maximumTidal) {
    deviationDerivative = covariant;
    covariantDerivative = vec4(0.0);
    for (int mu = 0; mu < 4; ++mu) {
        for (int alpha = 0; alpha < 4; ++alpha)
            for (int beta = 0; beta < 4; ++beta)
                deviationDerivative[mu] -=
                    gammaValue(center, mu, alpha, beta) * wave[alpha] * deviation[beta];
        float tidal = 0.0;
        for (int nu = 0; nu < 4; ++nu)
            for (int alpha = 0; alpha < 4; ++alpha)
                for (int beta = 0; beta < 4; ++beta) {
                    float riemann =
                        gammaDerivativeValue(
                            radialDerivative, polarDerivative, alpha, mu, nu, beta) -
                        gammaDerivativeValue(
                            radialDerivative, polarDerivative, beta, mu, nu, alpha);
                    for (int sigma = 0; sigma < 4; ++sigma)
                        riemann += gammaValue(center, mu, sigma, alpha) *
                                       gammaValue(center, sigma, nu, beta) -
                                   gammaValue(center, mu, sigma, beta) *
                                       gammaValue(center, sigma, nu, alpha);
                    tidal -= riemann * wave[nu] * deviation[alpha] * wave[beta];
                }
        covariantDerivative[mu] = tidal;
        for (int alpha = 0; alpha < 4; ++alpha)
            for (int beta = 0; beta < 4; ++beta)
                covariantDerivative[mu] -=
                    gammaValue(center, mu, alpha, beta) * wave[alpha] * covariant[beta];
        maximumTidal = max(maximumTidal, abs(tidal));
    }
}

BundleState bundleDerivative(BundleState state, inout float maximumTidal) {
    const Connection center = kerrConnection(state.position);
    const Connection radialDerivative = connectionDerivative(state.position, 1);
    const Connection polarDerivative = connectionDerivative(state.position, 2);
    BundleState result;
    result.position = state.wave;
    result.wave = vec4(0.0);
    for (int mu = 0; mu < 4; ++mu)
        for (int alpha = 0; alpha < 4; ++alpha)
            for (int beta = 0; beta < 4; ++beta)
                result.wave[mu] -=
                    gammaValue(center, mu, alpha, beta) * state.wave[alpha] * state.wave[beta];
    transportDeviation(
        center, radialDerivative, polarDerivative, state.wave,
        state.horizontal, state.horizontalDerivative,
        result.horizontal, result.horizontalDerivative, maximumTidal);
    transportDeviation(
        center, radialDerivative, polarDerivative, state.wave,
        state.vertical, state.verticalDerivative,
        result.vertical, result.verticalDerivative, maximumTidal);
    return result;
}

BundleState addBundle(BundleState state, BundleState derivative, float scale) {
    state.position += scale * derivative.position;
    state.wave += scale * derivative.wave;
    state.horizontal += scale * derivative.horizontal;
    state.horizontalDerivative += scale * derivative.horizontalDerivative;
    state.vertical += scale * derivative.vertical;
    state.verticalDerivative += scale * derivative.verticalDerivative;
    return state;
}

BundleState integrateJacobi(BundleState state, float step, inout float maximumTidal) {
    const BundleState first = bundleDerivative(state, maximumTidal);
    const BundleState midpoint = addBundle(state, first, 0.5 * step);
    const BundleState second = bundleDerivative(midpoint, maximumTidal);
    return addBundle(state, second, step);
}

bool finiteBundle(BundleState state) {
    return finiteVector(state.position) && finiteVector(state.wave) &&
        finiteVector(state.horizontal) && finiteVector(state.horizontalDerivative) &&
        finiteVector(state.vertical) && finiteVector(state.verticalDerivative);
}

bool finiteVector(vec4 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

void integrateActiveRay() {
    const uint slot = gl_GlobalInvocationID.x;
    if (slot >= control.activeCount) return;
    const uint rayIndex = activeRay(slot);
    RayState ray = rays.values[rayIndex];
    for (uint substep = 0u; substep < min(pushData.stepsPerDispatch, 8u) &&
         ray.counters.x == 0u; ++substep) {
        if (ray.position.x <= pushData.horizon) {
            ray.counters.x = 1u;
            break;
        }
        if (pushData.terminateAtObserver != 0u && ray.counters.y > 3u &&
            ray.conservedSigns.z > 0.0 && ray.position.x >= pushData.observerRadius) {
            ray.counters.x = 2u;
            break;
        }
        if (ray.integration.x >= ray.integration.y) {
            ray.counters.x = pushData.terminateAtObserver != 0u ? 3u : 2u;
            break;
        }
        const vec2 conserved = ray.conservedSigns.xy;
        vec2 signs = ray.conservedSigns.zw;
        const vec2 potential = kerrPotentials(ray.position, conserved);
        if (potential.x < 0.0) {
            signs.x = -signs.x;
            ++ray.counters.z;
        }
        if (potential.y < 0.0) {
            signs.y = -signs.y;
            ++ray.counters.z;
        }
        const float remaining = ray.integration.y - ray.integration.x;
        const float step = min(ray.integration.z, remaining);
        const vec4 coarse = kerrRk4(ray.position, conserved, signs, step);
        const vec4 midpoint = kerrRk4(ray.position, conserved, signs, 0.5 * step);
        const vec4 refined = kerrRk4(midpoint, conserved, signs, 0.5 * step);
        const vec4 scale = max(abs(refined), vec4(1.0));
        const vec4 relativeError = abs(refined - coarse) / scale;
        const float localError = max(max(relativeError.x, relativeError.y),
                                     max(relativeError.z, relativeError.w));
        ray.integration.w = max(ray.integration.w, localError);
        if (!finiteVector(refined) || isnan(localError) || isinf(localError)) {
            ray.counters.x = 3u;
        } else if (localError > pushData.errorTolerance && step > pushData.minimumStep) {
            ray.integration.z = max(pushData.minimumStep, 0.5 * step);
        } else {
            const vec2 refinedPotential = kerrPotentials(refined, conserved);
            if (refinedPotential.x < 0.0 || refinedPotential.y < 0.0) {
                if (refinedPotential.x < 0.0) signs.x = -signs.x;
                if (refinedPotential.y < 0.0) signs.y = -signs.y;
                ++ray.counters.z;
                ray.integration.z = max(pushData.minimumStep, 0.5 * step);
            } else {
                if (rayIndex < pushData.jacobiRayCount) {
                    BundleState bundle = BundleState(
                        ray.jacobiPosition,
                        ray.jacobiWave,
                        ray.horizontal,
                        ray.horizontalDerivative,
                        ray.vertical,
                        ray.verticalDerivative);
                    float maximumTidal = ray.jacobiDiagnostics.x;
                    bundle = integrateJacobi(bundle, step, maximumTidal);
                    ray.jacobiPosition = bundle.position;
                    ray.jacobiWave = bundle.wave;
                    ray.horizontal = bundle.horizontal;
                    ray.horizontalDerivative = bundle.horizontalDerivative;
                    ray.vertical = bundle.vertical;
                    ray.verticalDerivative = bundle.verticalDerivative;
                    ray.jacobiDiagnostics.x = maximumTidal;
                    ray.counters.w = finiteBundle(bundle) ? 1u : 0u;
                    if (ray.counters.w == 0u) ray.counters.x = 3u;
                }
                ray.position = refined;
                ray.integration.x += step;
                ++ray.counters.y;
                if (localError < pushData.errorTolerance * 0.08)
                    ray.integration.z = min(pushData.maximumStep, step * 1.35);
                if (ray.position.x <= pushData.horizon)
                    ray.counters.x = 1u;
                else if (pushData.terminateAtObserver != 0u && ray.counters.y > 3u &&
                         signs.x > 0.0 && ray.position.x >= pushData.observerRadius)
                    ray.counters.x = 2u;
                else if (ray.integration.x >= ray.integration.y - 1e-6)
                    ray.counters.x = pushData.terminateAtObserver != 0u ? 3u : 2u;
            }
        }
        ray.conservedSigns.zw = signs;
    }
    rays.values[rayIndex] = ray;
    flags.values[slot] = ray.counters.x == 0u ? 1u : 0u;
}

void scanActiveBlock() {
    const uint slot = gl_GlobalInvocationID.x;
    const uint lane = gl_LocalInvocationID.x;
    const uint value = slot < control.activeCount ? flags.values[slot] : 0u;
    scanA[lane] = value;
    barrier();
    bool sourceA = true;
    for (uint stride = 1u; stride < 256u; stride <<= 1u) {
        const uint own = sourceA ? scanA[lane] : scanB[lane];
        const uint preceding = lane >= stride ?
            (sourceA ? scanA[lane - stride] : scanB[lane - stride]) : 0u;
        if (sourceA)
            scanB[lane] = own + preceding;
        else
            scanA[lane] = own + preceding;
        barrier();
        sourceA = !sourceA;
    }
    const uint inclusive = sourceA ? scanA[lane] : scanB[lane];
    if (slot < control.activeCount) offsets.values[slot] = inclusive - value;
    barrier();
    if (lane == 255u) blockSums.values[gl_WorkGroupID.x] = inclusive;
}

void scanBlockSums() {
    const uint lane = gl_LocalInvocationID.x;
    const uint blockCount = (control.activeCount + 255u) / 256u;
    for (uint index = lane; index < 1024u; index += 256u)
        scanA[index] = index < blockCount ? blockSums.values[index] : 0u;
    barrier();
    bool sourceA = true;
    for (uint stride = 1u; stride < 1024u; stride <<= 1u) {
        for (uint index = lane; index < 1024u; index += 256u) {
            const uint own = sourceA ? scanA[index] : scanB[index];
            const uint preceding = index >= stride ?
                (sourceA ? scanA[index - stride] : scanB[index - stride]) : 0u;
            if (sourceA)
                scanB[index] = own + preceding;
            else
                scanA[index] = own + preceding;
        }
        barrier();
        sourceA = !sourceA;
    }
    for (uint index = lane; index < blockCount; index += 256u) {
        const uint inclusive = sourceA ? scanA[index] : scanB[index];
        blockOffsets.values[index] = inclusive - blockSums.values[index];
    }
    barrier();
    if (lane == 0u) {
        const uint nextCount = blockCount == 0u ? 0u :
            (sourceA ? scanA[blockCount - 1u] : scanB[blockCount - 1u]);
        control.previousCount = control.activeCount;
        control.activeCount = nextCount;
        ++control.iterations;
        indirectCommand.x = (nextCount + 255) / 256;
        indirectCommand.y = 1;
        indirectCommand.z = 1;
    }
}

void scatterActiveRays() {
    const uint slot = gl_GlobalInvocationID.x;
    if (slot >= control.previousCount || flags.values[slot] == 0) return;
    const uint outputSlot = blockOffsets.values[slot / 256u] + offsets.values[slot];
    writeNext(outputSlot, activeRay(slot));
}

void main() {
    if (pushData.phase == 0)
        integrateActiveRay();
    else if (pushData.phase == 1)
        scanActiveBlock();
    else if (pushData.phase == 2)
        scanBlockSums();
    else
        scatterActiveRays();
}
