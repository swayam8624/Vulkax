#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(std430, binding = 0) buffer Density { float values[]; } density;
layout(std430, binding = 1) buffer Temperature { float values[]; } temperature;
layout(std430, binding = 12) buffer DensityForward { float values[]; } densityForward;
layout(std430, binding = 13) buffer TemperatureForward { float values[]; } temperatureForward;
layout(std430, binding = 14) buffer DensityBackward { float values[]; } densityBackward;
layout(std430, binding = 15) buffer TemperatureBackward { float values[]; } temperatureBackward;
layout(std430, binding = 16) buffer DensityOutput { float values[]; } densityOutput;
layout(std430, binding = 17) buffer TemperatureOutput { float values[]; } temperatureOutput;
layout(std430, binding = 27) readonly buffer DesiredBricks { uint values[]; } desiredBricks;
layout(std430, binding = 32) buffer ScalarPageTable { uint values[]; } scalarPageTable;
layout(std430, binding = 33) buffer ScalarAllocator { uint values[]; } scalarAllocator;

layout(push_constant) uniform MacPass {
  uint nx;
  uint ny;
  uint nz;
  uint pass;
  float dt;
  float buoyancy;
  float smokeWeight;
  float parity;
  uint outputWidth;
  uint outputHeight;
  float extinction;
  float emission;
  uint triangleCount;
  float bodyMass;
  uint bodyCount;
  uint padding1;
} pushData;

uvec3 brickExtent() {
  return (uvec3(pushData.nx, pushData.ny, pushData.nz) + 3u) / 4u;
}

uint brickIndex(uvec3 brick) {
  const uvec3 extent = brickExtent();
  return (brick.z * extent.y + brick.y) * extent.x + brick.x;
}

uint acquireSlot() {
  for (;;) {
    const uint encodedHead = atomicAdd(scalarAllocator.values[1], 0u);
    if (encodedHead == 0u) break;
    const uint slot = encodedHead - 1u;
    const uint encodedNext = scalarAllocator.values[4u + slot];
    if (atomicCompSwap(scalarAllocator.values[1], encodedHead, encodedNext) == encodedHead) {
      memoryBarrierBuffer();
      return slot;
    }
  }
  const uint slot = atomicAdd(scalarAllocator.values[0], 1u);
  if (slot < scalarAllocator.values[3]) return slot;
  atomicAdd(scalarAllocator.values[2], 1u);
  return 0xffffffffu;
}

void releaseSlot(uint slot) {
  for (;;) {
    const uint encodedHead = atomicAdd(scalarAllocator.values[1], 0u);
    scalarAllocator.values[4u + slot] = encodedHead;
    memoryBarrierBuffer();
    if (atomicCompSwap(scalarAllocator.values[1], encodedHead, slot + 1u) == encodedHead) return;
  }
}

void clearSlot(uint slot) {
  const uint first = slot * 64u;
  for (uint local = 0u; local < 64u; ++local) {
    const uint index = first + local;
    density.values[index] = 0.0;
    temperature.values[index] = 0.0;
    densityForward.values[index] = 0.0;
    temperatureForward.values[index] = 0.0;
    densityBackward.values[index] = 0.0;
    temperatureBackward.values[index] = 0.0;
    densityOutput.values[index] = 0.0;
    temperatureOutput.values[index] = 0.0;
  }
}

void main() {
  const uvec3 brick = gl_GlobalInvocationID.xyz;
  const uvec3 extent = brickExtent();
  if (any(greaterThanEqual(brick, extent))) return;
  const uint page = brickIndex(brick);
  const bool desired = desiredBricks.values[page] != 0u;
  const uint encodedSlot = scalarPageTable.values[page];
  if (desired && encodedSlot == 0u) {
    const uint slot = acquireSlot();
    if (slot != 0xffffffffu) {
      clearSlot(slot);
      memoryBarrierBuffer();
      scalarPageTable.values[page] = slot + 1u;
    }
  } else if (!desired && encodedSlot != 0u) {
    scalarPageTable.values[page] = 0u;
    memoryBarrierBuffer();
    releaseSlot(encodedSlot - 1u);
  }
}
